        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} WORD@ FIELD RECORDER${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "  1) Audio Tape (Microphone)\n  2) Video Camcorder (Onboard Camera)"
        read -p " Select mode: " rec_mode
        read -p " Enter a name for this recording: " rec_name
        
        if [ "$rec_mode" == "1" ]; then
            if ! command -v arecord >/dev/null 2>&1; then echo -e "${RED}arecord tool missing.${NC}"; exit 1; fi
            echo -e "\n${WHITE}[ LIVE AUDIO RECORDING - Press ENTER to stop ]${NC}"
            TEMP_WAV="$BANK_DIR/audio/.$rec_name.tmp.wav"
            FINAL_MP3="$BANK_DIR/audio/$rec_name.mp3"
            arecord -f cd "$TEMP_WAV" -q &
            RECORD_PID=$!
            read -r
            kill $RECORD_PID 2>/dev/null
            echo -e "${WHITE}Processing audio...${NC}"
            if ffmpeg -y -i "$TEMP_WAV" -qscale:a 2 "$FINAL_MP3" 2>/dev/null; then
                rm -f "$TEMP_WAV"
                echo -e "${GREEN}Recording saved to WordBank as $rec_name.mp3${NC}"
            else
                echo -e "${RED}Error: Audio processing failed.${NC}"
            fi
        elif [ "$rec_mode" == "2" ]; then
            if [ ! -c /dev/video0 ]; then echo -e "${RED}No camera detected at /dev/video0.${NC}"; exit 1; fi
            echo -e "\n${WHITE}[ LIVE VIDEO CAMCORDER - Press ENTER to stop ]${NC}"
            FINAL_MP4="$BANK_DIR/video/$rec_name.mp4"
            ffmpeg -y -f v4l2 -i /dev/video0 -c:v libx264 -preset ultrafast -crf 28 "$FINAL_MP4" >/dev/null 2>&1 < /dev/null &
            RECORD_PID=$!
            read -r
            kill -INT $RECORD_PID 2>/dev/null
            sleep 1 
            echo -e "${GREEN}Video log saved to WordBank as $rec_name.mp4${NC}"
        else
            echo -e "${RED}Invalid selection.${NC}"
        fi
        exit 0
        ;;

    "write")
        if [ -n "$2" ]; then filename="$2"; else read -p "Enter document name: " filename; fi
        filepath="$BANK_DIR/text/$filename.txt"
        touch "$filepath"
        if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then xdg-open "$filepath" 2>/dev/null || nano "$filepath"
        else nano "$filepath"; fi
        exit 0
        ;;

    "raw")
        if [ -n "$2" ]; then filename="$2"; else read -p "Enter document name: " filename; fi
        TEMP_FILE="$BANK_DIR/text/.$filename.tmp"
        FINAL_FILE="$BANK_DIR/text/$filename.txt"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} RAW WRITING MODE ENGAGED${NC}"
        echo -e "${ORANGE} Type //SAVE on a new line to keep your work.\n Type //REJECT on a new line to burn it.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        > "$TEMP_FILE"
        while IFS= read -r line; do
            if [[ "$line" == "//SAVE" ]]; then
                mv "$TEMP_FILE" "$FINAL_FILE"
                echo -e "${WHITE}Draft secured in Bank as $filename.txt${NC}"
                exit 0
            elif [[ "$line" == "//REJECT" ]]; then
                rm -f "$TEMP_FILE"
                echo -e "${RED}Draft rejected. Burned to ash.${NC}"
                exit 0
            else
                echo "$line" >> "$TEMP_FILE"
            fi
        done
        ;;

    "?flop")
        if [ "$ACTIVE_TARGET" != "NONE" ] && mountpoint -q "$ACTIVE_TARGET" 2>/dev/null; then df -h "$ACTIVE_TARGET" | awk 'NR==1 || NR==2'
        else echo -e "${RED}No media mounted. Run ?scan.${NC}"; fi
        exit 0
        ;;

    "?gath")
        FILE_COUNT=$(find "$BANK_DIR" -type f | wc -l)
        if [ "$FILE_COUNT" -eq 0 ]; then echo -e "${ORANGE}The WordBank is currently empty.${NC}"; exit 0; fi
        BANK_SIZE=$(du -sh "$BANK_DIR" | awk '{print $1}')
        echo -e "${WHITE}Total Files  : $FILE_COUNT${NC}\n${WHITE}Total Weight : $BANK_SIZE${NC}"
        echo -e "\n${ORANGE}--- TEXT ---${NC}"; ls -lh "$BANK_DIR"/text 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- AUDIO ---${NC}"; ls -lh "$BANK_DIR"/audio 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- IMAGES ---${NC}"; ls -lh "$BANK_DIR"/images 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- GAMES ---${NC}"; ls -lh "$BANK_DIR"/games 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- VIDEO ---${NC}"; ls -lh "$BANK_DIR"/video 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        exit 0
        ;;

    "?when")
        ls -lt --time-style=+"%Y-%m-%d %H:%M" "$BANK_DIR"/*/* 2>/dev/null | awk '{print $6 " " $7 "\t" $8}'
        exit 0
        ;;

    "del!")
        echo -e "${RED}========================================${NC}"
        echo -e "${WHITE} BURN PROTOCOL INITIATED${NC}"
        echo -e "${RED}========================================${NC}"
        echo -e " 1) File         (Erase specific document)\n 2) Bank         (Purge local WordBank)\n 3) Media        (Format currently mounted disk)\n 4) Reset        (Full system ledger & bank reset)\n 5) Virtual Disk (Unmount & delete virtual .img)"
        read -p "Select protocol (1-5): " burn_choice
        case "$burn_choice" in
            1) read -p "Enter exact filename to burn (e.g. story.txt): " target
               FOUND=$(find "$BANK_DIR" -type f -name "$target" | head -n 1)
               if [ -n "$FOUND" ]; then rm -f "$FOUND"; echo -e "${RED}Erased.${NC}"; else echo -e "${ORANGE}Not found.${NC}"; fi
               press_enter ;;
            2) rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/* "$BANK_DIR"/games/* "$BANK_DIR"/video/*
               echo -e "${RED}Entire WordBank purged.${NC}" ;;
            3) if [ "$ACTIVE_TARGET" != "NONE" ]; then sudo rm -rf "${ACTIVE_TARGET:?}"/* "${ACTIVE_TARGET:?}"/.[!.]* 2>/dev/null; echo -e "${RED}Physical media wiped.${NC}"
               else echo -e "${RED}No target mounted to wipe.${NC}"; fi ;;
            4) > "$LEDGER_FILE"; rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/* "$BANK_DIR"/games/* "$BANK_DIR"/video/*
               echo -e "${RED}System Reset Complete.${NC}" ;;
            5) if [ -f "$VIRTUAL_IMG" ]; then sudo umount "/mnt/floppy" 2>/dev/null; rm -f "$VIRTUAL_IMG"; echo -e "${RED}Virtual Floppy image destroyed.${NC}"
               else echo -e "${ORANGE}No virtual floppy image found.${NC}"; fi
               press_enter ;;
        esac
        exit 0
        ;;

    "?work")
        [ -w "$BANK_DIR" ] && echo -e "Bank Directory   : ${WHITE}[OK]${NC}" || echo -e "Bank Directory   : ${RED}[FAIL]${NC}"
        ping -c 1 8.8.8.8 >/dev/null 2>&1 && echo -e "Network Access   : ${WHITE}[ONLINE]${NC}" || echo -e "Network Access   : ${RED}[OFFLINE]${NC}"
        exit 0
        ;;

    "update")
        if sudo curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word@" -o /usr/local/bin/word@; then
            sudo chmod +x /usr/local/bin/word@
            echo -e "${GREEN}word@ updated to latest version.${NC}"
        fi
        exit 0
        ;;

    *)
        echo -e "${RED}Unknown command. Type 'word@' to see the dashboard or 'word@ help!' for descriptions.${NC}"
        ;;
esac
