#!/bin/bash

# ==========================================
# SYSTEM VARIABLES & PATHS
# ==========================================
BANK_DIR="$HOME/word_at_bank"
LEDGER_FILE="$HOME/.floppy_ledger"
VIRTUAL_IMG="$BANK_DIR/.virtual_floppy.img"
STATE_FILE="$HOME/.word_at_state"
SAFE_OVERHEAD=50

# The Word@ Color Palette
ORANGE='\033[38;5;208m'
WHITE='\033[1;37m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Phonetic Array for Disk Naming
NATO=(ALPHA BRAVO CHARLIE DELTA ECHO FOXTROT GOLF HOTEL INDIA JULIETT KILO LIMA MIKE NOVEMBER OSCAR PAPA QUEBEC ROMEO SIERRA TANGO UNIFORM VICTOR WHISKEY XRAY YANKEE ZULU)

# Guarantee local Bank, Ledger, and Subfolders exist
mkdir -p "$BANK_DIR/text"
mkdir -p "$BANK_DIR/audio"
mkdir -p "$BANK_DIR/images"
mkdir -p "$BANK_DIR/games"
mkdir -p "$BANK_DIR/video"
touch "$LEDGER_FILE"
touch "$STATE_FILE"

# --- STATE MEMORY LOAD ---
source "$STATE_FILE" 2>/dev/null
[ -z "$ACTIVE_TARGET" ] && ACTIVE_TARGET="NONE"
[ -z "$MEDIA_TYPE" ] && MEDIA_TYPE="NONE"


# ==========================================
# GLOBAL HELPERS
# ==========================================
press_enter() {
    echo -e "\n${WHITE}Press [ENTER] to continue...${NC}"
    read -r
}

is_pkg_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "ok installed"
}


# ==========================================
# word@ ?inst - SYSTEM PACKAGE MANAGER
# ==========================================
installer_module() {
    local BASE_PKGS=("python3" "curl")
    local MEDIA_PKGS=("ffmpeg" "mpg123" "alsa-utils" "wodim" "qsstv" "imagemagick" "python3-opencv" "v4l-utils")
    local EXTRA_PKGS=("python3-blessed" "dosfstools") 
    local ALL_PKGS=("${BASE_PKGS[@]}" "${MEDIA_PKGS[@]}" "${EXTRA_PKGS[@]}")

    install_tier() {
        local tier_name="$1"
        shift
        local pkgs=("$@")
        local to_install=()

        for pkg in "${pkgs[@]}"; do
            if ! is_pkg_installed "$pkg"; then
                to_install+=("$pkg")
            fi
        done

        if [ ${#to_install[@]} -eq 0 ]; then
            echo -e "\n${GREEN}All packages in this tier are already installed.${NC}"
            sleep 2
            return
        fi

        echo -e "\n${WHITE}The following packages will be installed for the $tier_name tier:${NC}"
        for pkg in "${to_install[@]}"; do
            echo -e " - ${ORANGE}$pkg${NC}"
        done
        
        read -p "Proceed with installation? (Y/N): " confirm
        if [[ "${confirm,,}" == "y" ]]; then
            echo -e "${ORANGE}Updating grid repositories...${NC}"
            sudo apt-get update -qq
            for pkg in "${to_install[@]}"; do
                echo -e "${WHITE}Installing $pkg...${NC}"
                sudo apt-get install -y "$pkg"
            done
            echo -e "${GREEN}Installation complete.${NC}"
        else
            echo -e "${WHITE}Installation aborted.${NC}"
        fi
        sleep 2
    }

    fetch_github() {
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} GITHUB / REPOSITORY FETCHER${NC}"
        echo -e "${ORANGE}========================================${NC}"
        read -p " Enter RAW file URL: " raw_url
        if [ -z "$raw_url" ]; then
            echo -e "${RED}URL cannot be empty.${NC}"
            sleep 2
            return
        fi

        echo -e "\n${WHITE}Select Destination Category:${NC}"
        echo -e " 1) Games   ($BANK_DIR/games/)"
        echo -e " 2) Text    ($BANK_DIR/text/)"
        echo -e " 3) Images  ($BANK_DIR/images/)"
        echo -e " 4) Audio   ($BANK_DIR/audio/)"
        read -p " Destination (1-4): " dest_choice

        local dest_dir=""
        case "$dest_choice" in
            1) dest_dir="$BANK_DIR/games" ;;
            2) dest_dir="$BANK_DIR/text" ;;
            3) dest_dir="$BANK_DIR/images" ;;
            4) dest_dir="$BANK_DIR/audio" ;;
            *) echo -e "${RED}Invalid selection.${NC}"; sleep 1; return ;;
        esac

        local fname
        fname=$(basename "$raw_url")
        read -p " Save as filename [$fname]: " custom_fname
        [ -n "$custom_fname" ] && fname="$custom_fname"

        echo -e "\n${ORANGE}Fetching $fname...${NC}"
        if curl -sL "$raw_url" -o "$dest_dir/$fname"; then
            echo -e "${GREEN}Successfully pulled to $dest_dir/$fname${NC}"
        else
            echo -e "${RED}Download failed. Check URL or internet connection.${NC}"
        fi
        press_enter
    }

    while true; do
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} word@ PACKAGE MANAGER${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "  1) Install Package Tiers"
        echo -e "  2) View System Status"
        echo -e "  3) Fetch from GitHub / Web"
        echo -e "  4) Uninstall / Review a Package"
        echo -e "  q) Return to OS"
        echo -e "${ORANGE}========================================${NC}"
        read -p " Select action: " inst_choice

        case "$inst_choice" in
            1)
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} INSTALLATION TIERS${NC}"
                echo -e "${ORANGE}========================================${NC}"
                echo -e "  1) Base    (Core python & curl engine)"
                echo -e "  2) Media   (Audio, Video, Burning tools)"
                echo -e "  3) Extras  (Game UI libraries, formatting)"
                echo -e "  4) All     (Install everything)"
                echo -e "  q) Cancel"
                echo -e "${ORANGE}----------------------------------------${NC}"
                read -p " Select tier: " tier_choice
                
                case "$tier_choice" in
                    1) install_tier "BASE" "${BASE_PKGS[@]}" ;;
                    2) install_tier "MEDIA" "${MEDIA_PKGS[@]}" ;;
                    3) install_tier "EXTRAS" "${EXTRA_PKGS[@]}" ;;
                    4) install_tier "ALL (Advanced)" "${ALL_PKGS[@]}" ;;
                    q|Q) ;;
                    *) echo -e "${RED}Invalid selection.${NC}"; sleep 1 ;;
                esac
                ;;
            2)
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} SYSTEM PACKAGE STATUS${NC}"
                echo -e "${ORANGE}========================================${NC}"
                
                echo -e "${WHITE}[BASE CORE]${NC}"
                for pkg in "${BASE_PKGS[@]}"; do
                    if is_pkg_installed "$pkg"; then
                        echo -e "  ${GREEN}[INSTALLED]${NC} $pkg"
                    else
                        echo -e "  ${RED}[MISSING]${NC}   $pkg"
                    fi
                done
                
                echo -e "\n${WHITE}[MEDIA GENERAL]${NC}"
                for pkg in "${MEDIA_PKGS[@]}"; do
                    if is_pkg_installed "$pkg"; then
                        echo -e "  ${GREEN}[INSTALLED]${NC} $pkg"
                    else
                        echo -e "  ${RED}[MISSING]${NC}   $pkg"
                    fi
                done
                
                echo -e "\n${WHITE}[EXTRAS]${NC}"
                for pkg in "${EXTRA_PKGS[@]}"; do
                    if is_pkg_installed "$pkg"; then
                        echo -e "  ${GREEN}[INSTALLED]${NC} $pkg"
                    else
                        echo -e "  ${RED}[MISSING]${NC}   $pkg"
                    fi
                done
                
                echo -e "\n${ORANGE}----------------------------------------${NC}"
                press_enter
                ;;
            3)
                fetch_github
                ;;
            4)
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} MODULE REVIEW & REMOVAL${NC}"
                echo -e "${ORANGE}========================================${NC}"
                echo -e " 1) python3         (Base - System Brain)"
                echo -e " 2) ffmpeg          (Media - Audio Compression)"
                echo -e " 3) mpg123          (Media - Audio Playback)"
                echo -e " 4) alsa-utils      (Media - Mic Recording)"
                echo -e " 5) wodim           (Media - Hardware Burning)"
                echo -e " 6) python3-blessed (Extra - Game UI Library)"
                echo -e " q) Cancel"
                echo -e "${ORANGE}----------------------------------------${NC}"
                read -p " Select module to review: " un_choice

                case "$un_choice" in
                    1|2|3|4|5)
                        echo -e "\n${RED}[SYSTEM LOCK] Core/Media dependencies are protected from removal.${NC}"
                        sleep 3 ;;
                    6)
                        echo -e "\n${WHITE}MODULE: python3-blessed${NC}"
                        echo -e "Impact: Terminal games using Blessed will fail to render."
                        echo -e "${GREEN}[STATUS] Safe to remove. OS unaffected.${NC}"
                        
                        read -p " Proceed with uninstall? (Y/N): " conf1
                        if [[ "${conf1,,}" == "y" ]]; then
                            echo -e "${RED}Executing purge...${NC}"
                            sudo apt-get remove --purge -y python3-blessed
                            sudo apt-get autoremove -y
                            echo -e "${GREEN}Module purged.${NC}"
                            sleep 2
                        fi
                        ;;
                    q|Q) ;;
                    *) echo -e "${RED}Invalid selection.${NC}"; sleep 1 ;;
                esac
                ;;
            q|Q) return ;;
            *) echo -e "${RED}Invalid selection.${NC}"; sleep 1 ;;
        esac
    done
}


# ==========================================
# word@ FTF - UNIFIED FILE TO FLOPPY MODULE
# ==========================================
file_to_floppy_module() {
    if [ "$ACTIVE_TARGET" = "NONE" ] || [ ! -d "$ACTIVE_TARGET" ]; then
        echo -e "${RED}[ SYSTEM HALT: NO MEDIA MOUNTED. RUN '?scan' FIRST ]${NC}"
        press_enter
        return
    fi

    CURRENT_ID=$(cat "$ACTIVE_TARGET/.disk_id" 2>/dev/null)
    if [ -z "$CURRENT_ID" ]; then
        echo -e "${RED}[ MEDIA UNINITIALIZED. RUN 'word@ init' FIRST ]${NC}"
        press_enter
        return
    fi

    KNOWN_NAME=$(grep "ID: $CURRENT_ID" "$LEDGER_FILE" | awk -F'NAME: ' '{print $2}' | awk '{print $1}')
    [ -z "$KNOWN_NAME" ] && KNOWN_NAME="UNKNOWN"

    clear
    echo -e "${ORANGE}========================================${NC}"
    echo -e "${WHITE} FTF - FILE TO MEDIA ARCHIVE PROTOCOL${NC}"
    echo -e "${ORANGE} Target Disk: $KNOWN_NAME [$CURRENT_ID]${NC}"
    echo -e "${ORANGE} Target Path: $ACTIVE_TARGET${NC}"
    echo -e "${ORANGE}========================================${NC}"
    echo -e "  1) Text Archive   (Transfer .txt documents)"
    echo -e "  2) Sound Archive  (Compress & transfer .mp3)"
    echo -e "  3) Image Archive  (Transfer .jpg / .png images)"
    echo -e "  4) Game Archive   (Transfer .py game cartridges)"
    echo -e "  5) Video Archive  (Terminal-Optimized Encoding)"
    echo -e "  q) Return to OS"
    echo -e "${ORANGE}========================================${NC}"
    read -p " Select media type: " ftf_choice

    FREE_SPACE_KB=$(df -k "$ACTIVE_TARGET" | awk 'NR==2 {print $4}')

    case "$ftf_choice" in
        1) # TEXT
            echo -e "\n${WHITE}Archiving Text Documents...${NC}"
            shopt -s nullglob
            text_files=("$BANK_DIR"/text/*.txt)
            shopt -u nullglob

            if [ ${#text_files[@]} -eq 0 ]; then
                echo -e "${RED}No text files found in WordBank.${NC}"
                press_enter
                return
            fi

            for FILE in "${text_files[@]}"; do
                FILE_SIZE=$(du -k "$FILE" | cut -f1)
                [ -z "$FILE_SIZE" ] && FILE_SIZE=1
                REQUIRED_SPACE=$((FILE_SIZE * 2))

                if [ "$REQUIRED_SPACE" -le "$FREE_SPACE_KB" ]; then
                    BASENAME=$(basename "$FILE")
                    NAME="${BASENAME%.*}"
                    
                    sudo cp "$FILE" "$ACTIVE_TARGET/${NAME}.txt"
                    sudo cp "$FILE" "$ACTIVE_TARGET/${NAME}_BKP.txt"
                    
                    if ! grep -q "DISK_ID: $CURRENT_ID | FILE: $BASENAME" "$LEDGER_FILE"; then
                        echo "DISK_ID: $CURRENT_ID | DISK_NAME: $KNOWN_NAME | FILE: $BASENAME | DATE: $(date +%F)" >> "$LEDGER_FILE"
                    fi
                    
                    FREE_SPACE_KB=$((FREE_SPACE_KB - REQUIRED_SPACE))
                    echo -e "${WHITE}Archived & Indexed: $BASENAME${NC}"
                else
                    echo -e "${RED}Skipped: $BASENAME (Exceeds remaining space)${NC}"
                fi
            done
            echo -e "${GREEN}Text Archive Complete.${NC}"
            press_enter
            ;;

        2) # SOUND
            if ! command -v ffmpeg >/dev/null 2>&1; then
                echo -e "${RED}ffmpeg is missing. Run 'word@ ?inst' to resolve.${NC}"
                press_enter
                return
            fi

            if [ "$FREE_SPACE_KB" -lt 50 ]; then
                echo -e "${RED}CRITICAL ERROR: Insufficient magnetic surface space for compression.${NC}"
                press_enter
                return
            fi

            shopt -s nullglob
            audio_files=("$BANK_DIR"/audio/*.mp3)
            shopt -u nullglob

            if [ ${#audio_files[@]} -eq 0 ]; then
                echo -e "${RED}No audio files found in WordBank.${NC}"
                press_enter
                return
            fi

            i=1
            for f in "${audio_files[@]}"; do
                basename=$(basename "$f" | tr '[:lower:]' '[:upper:]')
                echo -e "  ${WHITE}$i)${NC} $basename"
                ((i++))
            done
            
            read -p "Select file number: " choice
            if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#audio_files[@]}" ]; then
                echo -e "${RED}Invalid selection.${NC}"
                press_enter
                return
            fi
            
            SELECTED_FILE="${audio_files[$((choice-1))]}"
            BASENAME=$(basename "$SELECTED_FILE")

            echo -e "\n${ORANGE}Select Compression Profile:${NC}"
            echo -e "  1) Short    (32kbps - High Quality)"
            echo -e "  2) Standard (16kbps - Balanced)"
            echo -e "  3) Long     (8kbps  - Max Length)"
            echo -e "  4) Auto     (Fit perfectly to disk)"
            read -p "Choice (1-4): " q_choice

            TARGET_BITRATE="16k" 
            case "$q_choice" in
                1) TARGET_BITRATE="32k" ;;
                2) TARGET_BITRATE="16k" ;;
                3) TARGET_BITRATE="8k" ;;
                4) 
                    DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$SELECTED_FILE" 2>/dev/null | awk '{print int($1)}')
                    [ -z "$DURATION" ] || [ "$DURATION" -le 0 ] && DURATION=1
                    MAX_BITRATE=$(( (FREE_SPACE_KB * 8) / DURATION ))
                    SAFE_BITRATE=$(( MAX_BITRATE * 95 / 100 ))
                    
                    if [ "$SAFE_BITRATE" -lt 6 ]; then
                        echo -e "${RED}WARNING: File is too long. Audio will be heavily degraded.${NC}"
                        TARGET_BITRATE="6k"
                    elif [ "$SAFE_BITRATE" -gt 64 ]; then
                        TARGET_BITRATE="64k" 
                    else
                        TARGET_BITRATE="${SAFE_BITRATE}k"
                    fi
                    echo -e "${ORANGE}Auto-calculated Bitrate: $TARGET_BITRATE${NC}"
                    ;;
                *) echo -e "${RED}Invalid profile. Defaulting to 16kbps.${NC}" ;;
            esac

            echo -e "${WHITE}Compressing & Transferring...${NC}"
            if ffmpeg -y -i "$SELECTED_FILE" -c:a libmp3lame -b:a "$TARGET_BITRATE" -ac 1 -ar 16000 "/tmp/$BASENAME" 2>/dev/null; then
                sudo cp "/tmp/$BASENAME" "$ACTIVE_TARGET/$BASENAME"
                rm "/tmp/$BASENAME"
                echo -e "${GREEN}Audio secured on physical disk.${NC}"
                read -p "Set track to Auto-Run on insert? (Y/N): " autorun_choice
                if [[ "${autorun_choice,,}" == "y" ]]; then
                    echo "$BASENAME" | sudo tee "$ACTIVE_TARGET/.autorun" >/dev/null
                    echo -e "${WHITE}Auto-Run protocol established.${NC}"
                fi
            else
                echo -e "${RED}Error: Audio compression failed.${NC}"
            fi
            press_enter
            ;;

        3) # IMAGES
            shopt -s nullglob
            img_files=("$BANK_DIR"/images/*)
            shopt -u nullglob

            if [ ${#img_files[@]} -eq 0 ]; then
                echo -e "${RED}No image files found in WordBank.${NC}"
                press_enter
                return
            fi

            for FILE in "${img_files[@]}"; do
                FILE_SIZE=$(du -k "$FILE" | cut -f1)
                [ -z "$FILE_SIZE" ] && FILE_SIZE=1
                if [ "$FILE_SIZE" -le "$FREE_SPACE_KB" ]; then
                    BASENAME=$(basename "$FILE")
                    sudo cp "$FILE" "$ACTIVE_TARGET/$BASENAME"
                    FREE_SPACE_KB=$((FREE_SPACE_KB - FILE_SIZE))
                    echo -e "${WHITE}Archived Image: $BASENAME${NC}"
                else
                    echo -e "${RED}Skipped: $BASENAME (Exceeds remaining space)${NC}"
                fi
            done
            echo -e "${GREEN}Image Archive Complete.${NC}"
            press_enter
            ;;

        4) # GAMES
            shopt -s nullglob
            game_files=("$BANK_DIR"/games/*.py)
            shopt -u nullglob

            if [ ${#game_files[@]} -eq 0 ]; then
                echo -e "${RED}No games found in WordBank.${NC}"
                press_enter
                return
            fi

            i=1
            for g in "${game_files[@]}"; do
                basename=$(basename "$g")
                echo -e "  ${WHITE}$i)${NC} $basename"
                ((i++))
            done
            read -p "Select game cartridge to transfer: " g_choice
            
            if [[ "$g_choice" =~ ^[0-9]+$ ]] && [ "$g_choice" -ge 1 ] && [ "$g_choice" -le "${#game_files[@]}" ]; then
                SEL_GAME="${game_files[$((g_choice-1))]}"
                BASENAME=$(basename "$SEL_GAME")
                FILE_SIZE=$(du -k "$SEL_GAME" | cut -f1)
                [ -z "$FILE_SIZE" ] && FILE_SIZE=1

                if [ "$FILE_SIZE" -le "$FREE_SPACE_KB" ]; then
                    sudo cp "$SEL_GAME" "$ACTIVE_TARGET/$BASENAME"
                    echo -e "${GREEN}Game cartridge '$BASENAME' copied to media.${NC}"
                    read -p "Set game to Auto-Run on insert? (Y/N): " autorun_choice
                    if [[ "${autorun_choice,,}" == "y" ]]; then
                        echo "$BASENAME" | sudo tee "$ACTIVE_TARGET/.autorun" >/dev/null
                        echo -e "${WHITE}Auto-Run protocol established.${NC}"
                    fi
                else
                    echo -e "${RED}Error: Cartridge exceeds media space.${NC}"
                fi
            else
                echo -e "${RED}Invalid selection.${NC}"
            fi
            press_enter
            ;;

        5) # VIDEO
            if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
                echo -e "${RED}ffmpeg is missing. Run 'word@ ?inst' to resolve.${NC}"
                press_enter
                return
            fi
            
            if [ "$FREE_SPACE_KB" -lt 50 ]; then
                echo -e "${RED}CRITICAL ERROR: Insufficient magnetic surface space for video compression.${NC}"
                press_enter
                return
            fi

            shopt -s nullglob
            vid_files=("$BANK_DIR"/video/*.mp4)
            shopt -u nullglob

            if [ ${#vid_files[@]} -eq 0 ]; then
                echo -e "${RED}No video files found in WordBank.${NC}"
                press_enter
                return
            fi

            echo -e "\n${ORANGE}Select Video Compression Protocol:${NC}"
            echo -e "  1) Standard Crush  (Lower Res/FPS, Maintain Audio)"
            echo -e "  2) ASCII Optimized (80px Width, Strip Audio, 15 FPS)"
            echo -e "  ${RED}3) [WARNING] AUTOMATIC (Force Fit or Fail)${NC}"
            read -p "Choice (1-3): " v_choice

            valid_vids=()
            
            if [ "$v_choice" == "3" ]; then
                echo -e "${WHITE}Scanning WordBank for theoretical hardware limits...${NC}"
                for v in "${vid_files[@]}"; do
                    DUR=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$v" 2>/dev/null | awk '{print int($1)}')
                    [ -z "$DUR" ] || [ "$DUR" -le 0 ] && DUR=1
                    MAX_B=$(( (FREE_SPACE_KB * 8) / DUR ))
                    if [ "$MAX_B" -ge 12 ]; then
                        valid_vids+=("$v")
                    fi
                done
                if [ ${#valid_vids[@]} -eq 0 ]; then
                    echo -e "${RED}FAILURE: No videos in the WordBank are short enough to physically fit on this disk.${NC}"
                    press_enter
                    return
                fi
            else
                valid_vids=("${vid_files[@]}")
            fi

            i=1
            for v in "${valid_vids[@]}"; do
                basename=$(basename "$v")
                echo -e "  ${WHITE}$i)${NC} $basename"
                ((i++))
            done
            
            read -p "Select video cartridge to archive: " choice
            if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#valid_vids[@]}" ]; then
                echo -e "${RED}Invalid selection.${NC}"
                press_enter
                return
            fi
            
            SEL_VID="${valid_vids[$((choice-1))]}"
            BASENAME=$(basename "$SEL_VID")
            
            DUR=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$SEL_VID" 2>/dev/null | awk '{print int($1)}')
            [ -z "$DUR" ] || [ "$DUR" -le 0 ] && DUR=1
            TARGET_BITRATE=$(( (FREE_SPACE_KB * 8) / DUR * 90 / 100 ))k

            echo -e "${WHITE}Initializing hardware compression engine...${NC}"
            
            case "$v_choice" in
                1) 
                    ffmpeg -y -i "$SEL_VID" -vf scale=160:-2 -r 12 -b:v "$TARGET_BITRATE" -b:a 16k -ac 1 -ar 16000 "/tmp/$BASENAME" 2>/dev/null
                    ;;
                2) 
                    ffmpeg -y -i "$SEL_VID" -vf scale=80:-2 -r 15 -b:v "$TARGET_BITRATE" -an "/tmp/$BASENAME" 2>/dev/null
                    ;;
                3) 
                    ffmpeg -y -i "$SEL_VID" -vf scale=80:-2 -r 10 -b:v "$TARGET_BITRATE" -an "/tmp/$BASENAME" 2>/dev/null
                    ;;
                *) echo -e "${RED}Invalid profile.${NC}"; return ;;
            esac

            FINAL_SIZE=$(du -k "/tmp/$BASENAME" | cut -f1)
            [ -z "$FINAL_SIZE" ] && FINAL_SIZE=1

            if [ "$FINAL_SIZE" -le "$FREE_SPACE_KB" ]; then
                sudo cp "/tmp/$BASENAME" "$ACTIVE_TARGET/$BASENAME"
                rm "/tmp/$BASENAME"
                echo -e "${GREEN}Video cartridge '$BASENAME' secured on physical media.${NC}"
                read -p "Set video to Auto-Run ASCII playback on insert? (Y/N): " autorun_choice
                if [[ "${autorun_choice,,}" == "y" ]]; then
                    echo "$BASENAME" | sudo tee "$ACTIVE_TARGET/.autorun" >/dev/null
                    echo -e "${WHITE}Auto-Run protocol established.${NC}"
                fi
            else
                rm "/tmp/$BASENAME"
                echo -e "\n${RED}[ WARNING: THIS FILE DOES NOT FIT ]${NC}"
                echo -e "${RED}$BASENAME${NC}"
                echo -e "${ORANGE}Compression failed to breach the hardware limit.${NC}"
            fi
            press_enter
            ;;

        q|Q) return ;;
        *) echo -e "${RED}Invalid selection.${NC}"; sleep 1 ;;
    esac
}


# ==========================================
# word@ ?calc - HYBRID PYTHON MATH ENGINE
# ==========================================
execute_python_math() {
    local math_input="$1"
    
    if [[ "${math_input,,}" == "pi" ]]; then
        echo -e "${ORANGE} STREAMING NILAKANTHA SERIES (Press CTRL+C to stop)${NC}"
        tput civis
        python3 -c "
import sys, time
pi_est = 3.0
n = 2
sign = 1
print('\033[1;37m Formula: Pi = 3 + 4/(2*3*4) - 4/(4*5*6) + 4/(6*7*8)...\033[0m\n')
try:
    iteration = 1
    while True:
        term = 4.0 / (n * (n+1) * (n+2))
        if sign == 1: pi_est += term
        else: pi_est -= term
        sys.stdout.write(f'\r \033[0;32m[Iter {iteration}]\033[0m Math: {\"+\" if sign==1 else \"-\"}{term:.8f} | Current Pi ≈ {pi_est:.14f}')
        sys.stdout.flush()
        n += 2
        sign *= -1
        iteration += 1
        time.sleep(0.05)
except KeyboardInterrupt:
    sys.stdout.write('\n\n\033[0;31m Calculation Halted.\033[0m\n')
    sys.exit(0)
"
        tput cnorm
        echo -e "\n"
    else
        python3 -c "
import sys, time
from math import *

expr = sys.argv[1]

s = expr.replace('{','(').replace('}',')').replace('[','(').replace(']',')').replace('x','*').replace('X','*').replace('^','**')
s = s.replace(' ', '')

print(f'\033[1;37m[Original]\033[0m {s}')

try:
    step = 1
    while '(' in s:
        start = s.rfind('(')
        end = s.find(')', start)
        if end == -1: raise ValueError('Unmatched bracket')
        
        func_start = start
        while func_start > 0 and s[func_start-1].isalpha():
            func_start -= 1
            
        chunk = s[func_start:end+1]
        val = eval(chunk)
        if isinstance(val, float) and val.is_integer(): val = int(val)
        
        s = s[:func_start] + str(val) + s[end+1:]
        time.sleep(0.3)
        print(f'\033[38;5;208m[Step {step}]\033[0m  {s}')
        step += 1
        
    ans = eval(s)
    if isinstance(ans, float) and ans.is_integer(): ans = int(ans)
    time.sleep(0.3)
    print(f'\033[0;32m[Final]\033[0m    {ans}\n')
    
except Exception as e:
    print('\033[0;31m Invalid Syntax or Math Error\033[0m\n')
" "$math_input"
    fi
}

