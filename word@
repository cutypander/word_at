#!/bin/bash

# ==========================================
# SYSTEM VARIABLES & PATHS
# ==========================================
BANK_DIR="$HOME/WordBank"
FLOPPY_DIR="/mnt/floppy"
LEDGER_FILE="$HOME/.floppy_ledger"
SAFE_OVERHEAD=50

# The Word@ Color Palette
ORANGE='\033[38;5;208m'
WHITE='\033[1;37m'
RED='\033[0;31m'
NC='\033[0m'

# Phonetic Array for Disk Naming
NATO=(ALPHA BRAVO CHARLIE DELTA ECHO FOXTROT GOLF HOTEL INDIA JULIETT KILO LIMA MIKE NOVEMBER OSCAR PAPA QUEBEC ROMEO SIERRA TANGO UNIFORM VICTOR WHISKEY XRAY YANKEE ZULU)

# Guarantee local Bank and Ledger exist
mkdir -p "$BANK_DIR"
touch "$LEDGER_FILE"

# ==========================================
# DEPENDENCY CHECKS
# ==========================================
check_audio_engine() {
    if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v mpg123 >/dev/null 2>&1 || ! command -v arecord >/dev/null 2>&1; then
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} AUDIO ENGINE INITIALIZATION${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${RED}Missing required tools: ffmpeg, mpg123, alsa-utils${NC}"
        read -p "Install dependencies now? (Y/N): " install_choice
        
        if [[ "$install_choice" == "Y" || "$install_choice" == "y" ]]; then
            echo -e "${WHITE}Fetching packages from the grid...${NC}"
            sudo apt-get update -qq
            if sudo apt-get install -y ffmpeg mpg123 alsa-utils >/dev/null 2>&1; then
                echo -e "${WHITE}Audio engine downloaded, continuing with task.${NC}"
                echo -e "${ORANGE}----------------------------------------${NC}"
            else
                echo -e "${RED}Error: Installation failed. Check network connection.${NC}"
                exit 1
            fi
        else
            echo -e "${RED}Audio commands cannot be used without these packages. Aborting.${NC}"
            exit 1
        fi
    fi
}

# ==========================================
# THE SWITCHBOARD
# ==========================================
case "$1" in

    "?well")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE}   Welcome to the Terminal Workspace    ${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${ORANGE}This is a distraction-free drafting environment."
        echo -e "Everything you write is secured in a local bank"
        echo -e "before being archived to physical floppy disks.${NC}\n"
        
        # --- NEW HARDWARE SCANNER ---
        if mount | grep -q "$FLOPPY_DIR"; then
            echo -e "  Hardware Status : ${WHITE}[FLOPPY DRIVE ACTIVE]${NC}"
        else
            echo -e "  Hardware Status : ${RED}[NO DISK MOUNTED]${NC}"
        fi
        echo ""
        
        echo -e "${ORANGE}To see the available commands, type: ${WHITE}word@ help!${NC}"
        echo -e "${ORANGE}========================================${NC}"
        exit 0
        ;;

    "help!")
        echo -e "${WHITE}COMMAND DIRECTORY:${NC}"
        echo -e "  ${WHITE}[no flag]${NC} - Standard Mode: Open a file (Nano/Desktop)."
        echo -e "  ${WHITE}raw${NC}       - Raw Mode: Write directly to the terminal."
        echo -e "  ${WHITE}tape${NC}      - Field Recorder: Record MP3 audio to Bank."
        echo -e "  ${WHITE}TTF${NC}       - Text To Floppy: Archive text bank to disk."
        echo -e "  ${WHITE}STF${NC}       - Sound To Floppy: Archive audio with compression."
        echo -e "  ${WHITE}init${NC}      - Format, scan, and stamp a new floppy."
        echo -e "  ${WHITE}?scan${NC}     - Run advanced scanner protocols & auto-run."
        echo -e "  ${WHITE}?flop${NC}     - Check floppy drive status/capacity."
        echo -e "  ${WHITE}?gath${NC}     - Calculate file sizes and bank weight."
        echo -e "  ${WHITE}?when${NC}     - Display creation/modification dates."
        echo -e "  ${WHITE}view${NC}      - Stream text (16-bit) or playback audio."
        echo -e "  ${WHITE}del!${NC}      - Access system burn protocols."
        echo -e "  ${WHITE}?work${NC}     - Run system access diagnostics."
        echo -e "  ${WHITE}update${NC}    - Pull the latest version from GitHub."
        exit 0
        ;;

    "raw")
        if [ -n "$2" ]; then
            filename="$2"
        else
            read -p "Enter document name: " filename
        fi
        
        TEMP_FILE="$BANK_DIR/.$filename.tmp"
        FINAL_FILE="$BANK_DIR/$filename.txt"
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} RAW WRITING MODE ENGAGED${NC}"
        echo -e "${ORANGE} Type //SAVE on a new line to keep your work."
        echo -e " Type //REJECT on a new line to burn it.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        > "$TEMP_FILE"
        
        while IFS= read -r line; do
            if [[ "$line" == "//SAVE" ]]; then
                mv "$TEMP_FILE" "$FINAL_FILE"
                echo -e "${WHITE}Draft secured in Bank as $filename.txt${NC}"
                exit 0
            elif [[ "$line" == "//REJECT" ]]; then
                rm -f "$TEMP_FILE"
                echo -e "${RED}Draft rejected. Burned to ash.${NC}"
                exit 0
            else
                echo "$line" >> "$TEMP_FILE"
            fi
        done
        ;;

    "tape")
        check_audio_engine
        
        read -p "Enter a name for this recording: " rec_name
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} LIVE AUDIO RECORDING${NC}"
        echo -e "${ORANGE} Press [ENTER] to stop recording.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        TEMP_WAV="$BANK_DIR/.$rec_name.tmp.wav"
        FINAL_MP3="$BANK_DIR/$rec_name.mp3"
        
        # Start recording in the background
        arecord -f cd "$TEMP_WAV" -q &
        RECORD_PID=$!
        
        # Wait for the user to hit Enter
        read -r
        kill $RECORD_PID 2>/dev/null
        
        echo -e "${WHITE}Processing audio...${NC}"
        if ffmpeg -y -i "$TEMP_WAV" -qscale:a 2 "$FINAL_MP3" 2>/dev/null; then
            rm -f "$TEMP_WAV"
            echo -e "${ORANGE}Recording saved to WordBank as $rec_name.mp3${NC}"
        else
            echo -e "${RED}Error: Audio processing failed.${NC}"
        fi
        exit 0
        ;;

    "init")
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: No disk inserted to initialize.${NC}"
            exit 1
        fi
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE}   INITIALIZING NEW FLOPPY HARDWARE${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        NEW_ID=$(tr -dc A-Z0-9 </dev/urandom | head -c 6)
        
        WORD1=${NATO[$RANDOM % 26]}
        if grep -q "NAME: $WORD1" "$LEDGER_FILE"; then
            WORD2=${NATO[$RANDOM % 26]}
            DISK_NAME="$WORD1-$WORD2"
        else
            DISK_NAME="$WORD1"
        fi
        
        echo "$NEW_ID" > "$FLOPPY_DIR/.disk_id"
        echo -e "${WHITE}Hardware Stamped. Assigned Name: $DISK_NAME${NC}"
        
        echo -e "${ORANGE}Running deep magnetic scan (This will take a moment)...${NC}"
        DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
        BAD_COUNT=$(sudo badblocks -q "$DEVICE" | wc -l)
        
        if [ "$BAD_COUNT" -gt 0 ]; then
            echo -e "${RED}WARNING: $BAD_COUNT dead sectors detected.${NC}"
        else
            echo -e "${WHITE}Scan complete. Surface integrity is 100%.${NC}"
        fi
        
        echo "ID: $NEW_ID | NAME: $DISK_NAME | BAD_BLOCKS: $BAD_COUNT" >> "$LEDGER_FILE"
        echo -e "${ORANGE}Disk successfully integrated into the ecosystem.${NC}"
        exit 0
        ;;

    "TTF")
        echo -e "${WHITE}Initiating Text-to-Floppy Archive Protocol...${NC}"
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: Floppy drive not detected.${NC}"
            exit 1
        fi

        CURRENT_ID=$(cat "$FLOPPY_DIR/.disk_id" 2>/dev/null)
        if [ -z "$CURRENT_ID" ]; then
            echo -e "${RED}Disk is uninitialized. Run 'word@ init' first.${NC}"
            exit 1
        fi

        KNOWN_NAME=$(grep "ID: $CURRENT_ID" "$LEDGER_FILE" | awk -F'NAME: ' '{print $2}' | awk '{print $1}')
        BAD_BLOCKS=$(grep "ID: $CURRENT_ID" "$LEDGER_FILE" | awk -F'BAD_BLOCKS: ' '{print $2}' | awk '{print $1}')
        
        echo -e "${ORANGE}Archiving Bank to Floppy: $KNOWN_NAME${NC}"

        FREE_SPACE=$(df -k "$FLOPPY_DIR" | awk 'NR==2 {print $4}')
        SAFE_SPACE=$((FREE_SPACE - BAD_BLOCKS - SAFE_OVERHEAD))

        for FILE in "$BANK_DIR"/*.txt; do
            [ -e "$FILE" ] || continue
            FILE_SIZE=$(du -k "$FILE" | cut -f1)
            REQUIRED_SPACE=$((FILE_SIZE * 2))

            if [ "$REQUIRED_SPACE" -le "$SAFE_SPACE" ]; then
                BASENAME=$(basename "$FILE")
                NAME="${BASENAME%.*}"
                
                cp "$FILE" "$FLOPPY_DIR/${NAME}.txt"
                cp "$FILE" "$FLOPPY_DIR/${NAME}_BKP.txt"
                
                if ! grep -q "DISK_ID: $CURRENT_ID | FILE: $BASENAME" "$LEDGER_FILE"; then
                    echo "DISK_ID: $CURRENT_ID | DISK_NAME: $KNOWN_NAME | FILE: $BASENAME | DATE: $(date +%F)" >> "$LEDGER_FILE"
                fi
                
                SAFE_SPACE=$((SAFE_SPACE - REQUIRED_SPACE))
                echo -e "${WHITE}Archived & Indexed: $BASENAME${NC}"
            else
                echo -e "${RED}Skipped: $BASENAME (Exceeds remaining space)${NC}"
            fi
        done
        echo -e "${ORANGE}TTF Transfer Complete.${NC}"
        exit 0
        ;;

    "STF")
        check_audio_engine
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} SOUND TO FLOPPY ARCHIVE PROTOCOL${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: Floppy drive not detected.${NC}"
            exit 1
        fi
        
        # 1. Build Uppercase Grid Menu
        shopt -s nullglob
        files=("$BANK_DIR"/*.mp3)
        shopt -u nullglob
        
        if [ ${#files[@]} -eq 0 ]; then
            echo -e "${RED}No audio files found in WordBank.${NC}"
            exit 1
        fi

        i=1
        for f in "${files[@]}"; do
            basename=$(basename "$f" | tr '[:lower:]' '[:upper:]')
            echo -e "  ${WHITE}$i)${NC} $basename"
            ((i++))
        done
        
        read -p "Select file number: " choice
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#files[@]}" ]; then
            echo -e "${RED}Invalid selection.${NC}"
            exit 1
        fi
        
        SELECTED_FILE="${files[$((choice-1))]}"
        BASENAME=$(basename "$SELECTED_FILE")
        
        echo -e "\n${ORANGE}Select Compression Profile:${NC}"
        echo -e "  1) Short    (32kbps - High Quality)"
        echo -e "  2) Standard (16kbps - Balanced)"
        echo -e "  3) Long     (8kbps  - Max Length)"
        echo -e "  4) Auto     (Fit perfectly to disk)"
        read -p "Choice (1-4): " q_choice

        FREE_SPACE_KB=$(df -k "$FLOPPY_DIR" | awk 'NR==2 {print $4}')
        if [ "$FREE_SPACE_KB" -le 0 ]; then
            echo -e "${RED}Error: Floppy is completely full.${NC}"
            exit 1
        fi

        TARGET_BITRATE="16k" 
        case "$q_choice" in
            1) TARGET_BITRATE="32k" ;;
            2) TARGET_BITRATE="16k" ;;
            3) TARGET_BITRATE="8k" ;;
            4) 
                DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$SELECTED_FILE" | awk '{print int($1)}')
                if [ "$DURATION" -le 0 ]; then DURATION=1; fi
                MAX_BITRATE=$(( (FREE_SPACE_KB * 8) / DURATION ))
                SAFE_BITRATE=$(( MAX_BITRATE * 95 / 100 ))
                
                if [ "$SAFE_BITRATE" -lt 6 ]; then
                    echo -e "${RED}WARNING: File is too long. Audio will be heavily degraded.${NC}"
                    TARGET_BITRATE="6k"
                elif [ "$SAFE_BITRATE" -gt 64 ]; then
                    TARGET_BITRATE="64k" 
                else
                    TARGET_BITRATE="${SAFE_BITRATE}k"
                fi
                echo -e "${ORANGE}Auto-calculated Bitrate: $TARGET_BITRATE${NC}"
                ;;
            *) echo -e "${RED}Invalid profile. Defaulting to 16kbps.${NC}" ;;
        esac

        echo -e "${WHITE}Compressing & Transferring...${NC}"
        if ffmpeg -y -i "$SELECTED_FILE" -c:a libmp3lame -b:a "$TARGET_BITRATE" -ac 1 -ar 16000 "$FLOPPY_DIR/$BASENAME" 2>/dev/null; then
            echo -e "${ORANGE}Audio secured on physical disk.${NC}"
            
            read -p "Set this track to Auto-Run on insert? (Y/N): " autorun_choice
            if [[ "$autorun_choice" == "Y" || "$autorun_choice" == "y" ]]; then
                echo "$BASENAME" > "$FLOPPY_DIR/.autorun"
                echo -e "${WHITE}Auto-Run protocol established.${NC}"
            fi
        else
            echo -e "${RED}Error: Audio compression failed.${NC}"
        fi
        exit 0
        ;;

    "?scan")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} ADVANCED SCANNER PROTOCOLS${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "  ${WHITE}1)${NC} Surface Scan (Check magnetic integrity)"
        echo -e "  ${WHITE}2)${NC} Local Hunt   (Search Pi and move to Bank)"
        echo -e "  ${WHITE}3)${NC} Ledger Scan  (Find a file's physical disk)"
        echo -e "  ${WHITE}4)${NC} Auto-Execute (Trigger .autorun or script)"
        echo -e "${ORANGE}========================================${NC}"
        read -p "Select protocol (1-4): " scan_choice

        case "$scan_choice" in
            1)
                DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
                echo -e "${ORANGE}Listening for dead sectors on $DEVICE...${NC}"
                sudo badblocks -v "$DEVICE"
                ;;
            2)
                read -p "Enter exact filename to hunt: " hunt_target
                echo -e "${ORANGE}Sweeping local system...${NC}"
                FOUND_PATH=$(find "$HOME" -type f -name "$hunt_target" 2>/dev/null | head -n 1)
                
                if [ -n "$FOUND_PATH" ]; then
                    echo -e "${WHITE}Target acquired at: $FOUND_PATH${NC}"
                    read -p "Import to WordBank? (Y/N): " import_choice
                    if [[ "$import_choice" == "Y" || "$import_choice" == "y" ]]; then
                        cp "$FOUND_PATH" "$BANK_DIR/"
                    fi
                else
                    echo -e "${RED}File not found on local system.${NC}"
                fi
                ;;
            3)
                read -p "Enter document name to locate: " doc_target
                if grep -q "FILE: $doc_target" "$LEDGER_FILE"; then
                    grep "FILE: $doc_target" "$LEDGER_FILE"
                else
                    echo -e "${RED}Document not found in physical archives.${NC}"
                fi
                ;;
            4)
                if [ -d "$FLOPPY_DIR" ]; then
                    # 1. Check for Audio Autorun
                    if [ -f "$FLOPPY_DIR/.autorun" ]; then
                        check_audio_engine
                        AUTORUN_FILE=$(cat "$FLOPPY_DIR/.autorun")
                        if [ -f "$FLOPPY_DIR/$AUTORUN_FILE" ]; then
                            echo -e "${WHITE}Auto-Run triggered: $AUTORUN_FILE${NC}"
                            mpg123 -q "$FLOPPY_DIR/$AUTORUN_FILE" 2>/dev/null
                            exit 0
                        fi
                    fi
                    
                    # 2. Check for Shell Script
                    SCRIPT_FILE=$(ls -1 "$FLOPPY_DIR"/*.sh 2>/dev/null | head -n 1)
                    if [ -n "$SCRIPT_FILE" ]; then
                        echo -e "${WHITE}Executing $SCRIPT_FILE...${NC}"
                        bash "$SCRIPT_FILE"
                    else
                        echo -e "${RED}No auto-run media or scripts found on floppy.${NC}"
                    fi
                fi
                ;;
        esac
        exit 0
        ;;

    "view")
        read -p "Enter document or audio name to view/play: " target
        
        if [ -f "$BANK_DIR/$target.txt" ]; then
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} STREAMING DATA: $target.txt${NC}"
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE}"
            
            while IFS= read -r line; do
                for (( i=0; i<${#line}; i++ )); do
                    echo -n "${line:$i:1}"
                    sleep 0.02
                done
                echo ""
            done < "$BANK_DIR/$target.txt"
            
            echo -e "${NC}"
            echo -e "${ORANGE}========================================${NC}"
            
        elif [ -f "$BANK_DIR/$target.mp3" ]; then
            check_audio_engine
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} PLAYING AUDIO: $target.mp3${NC}"
            echo -e "${ORANGE}========================================${NC}"
            mpg123 -q "$BANK_DIR/$target.mp3" 2>/dev/null
        else
            echo -e "${RED}Target '$target' not found in WordBank.${NC}"
        fi
        exit 0
        ;;

    "?flop")
        if mount | grep -q "$FLOPPY_DIR"; then
            df -h "$FLOPPY_DIR" | awk 'NR==1 || NR==2'
        else
            echo -e "${RED}No floppy mounted at $FLOPPY_DIR.${NC}"
        fi
        exit 0
        ;;

    "?gath")
        FILE_COUNT=$(ls -1q "$BANK_DIR"/*.txt "$BANK_DIR"/*.mp3 2>/dev/null | wc -l)
        if [ "$FILE_COUNT" -eq 0 ]; then
            echo -e "${ORANGE}The WordBank is currently empty.${NC}"
            exit 0
        fi
        BANK_SIZE=$(du -sh "$BANK_DIR" | awk '{print $1}')
        echo -e "${WHITE}Total Files  : $FILE_COUNT${NC}"
        echo -e "${WHITE}Total Weight : $BANK_SIZE${NC}"
        ls -lh "$BANK_DIR" 2>/dev/null | awk '{print $5 "\t" $9}'
        exit 0
        ;;

    "?when")
        ls -lt --time-style=+"%Y-%m-%d %H:%M" "$BANK_DIR" 2>/dev/null | awk '{print $6 " " $7 "\t" $8}'
        exit 0
        ;;

    "del!")
        echo -e "${RED}========================================${NC}"
        echo -e "${WHITE} BURN PROTOCOL INITIATED${NC}"
        echo -e "${RED}========================================${NC}"
        read -p "Select protocol (1=File, 2=Bank, 3=Floppy, 4=Reset): " burn_choice

        case "$burn_choice" in
            1)
                read -p "Enter full filename to burn (e.g. story.txt): " target
                rm -f "$BANK_DIR/$target" && echo -e "${RED}Erased.${NC}" || echo -e "${ORANGE}Not found.${NC}"
                ;;
            2)
                rm -f "$BANK_DIR"/* && echo -e "${RED}WordBank purged.${NC}"
                ;;
            3)
                sudo rm -rf "$FLOPPY_DIR"/* && echo -e "${RED}Physical disk wiped.${NC}"
                ;;
            4)
                > "$LEDGER_FILE"
                rm -f "$BANK_DIR"/*
                echo -e "${RED}System Reset Complete.${NC}"
                ;;
        esac
        exit 0
        ;;

    "?work")
        [ -w "$BANK_DIR" ] && echo -e "Bank Directory   : ${WHITE}[OK]${NC}" || echo -e "Bank Directory   : ${RED}[FAIL]${NC}"
        ping -c 1 8.8.8.8 >/dev/null 2>&1 && echo -e "Network Access   : ${WHITE}[ONLINE]${NC}" || echo -e "Network Access   : ${RED}[OFFLINE]${NC}"
        exit 0
        ;;

    "update")
        if sudo curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word@" -o /usr/local/bin/word@; then
            sudo chmod +x /usr/local/bin/word@
            echo -e "${WHITE}word@ updated to latest version.${NC}"
        fi
        exit 0
        ;;

    *)
        # Default behavior: Open file
        if [ -n "$1" ]; then
            filename="$1"
        else
            read -p "Enter document name: " filename
        fi
        filepath="$BANK_DIR/$filename.txt"
        
        # Check if user is on a Desktop GUI or pure Terminal
        if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then
            # We are on a desktop, open cleanly in default visual editor
            xdg-open "$filepath" 2>/dev/null || nano "$filepath"
        else
            # Pure terminal, stick to the gritty retro vibes
            nano "$filepath"
        fi
        ;;
esac
