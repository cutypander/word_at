#!/bin/bash

# ==========================================
# word@ OS CORE - FEATHERWEIGHT EDITION (v3.2)
# ==========================================
KERNEL_VERSION="3.2"
BANK_DIR="$HOME/word_at_bank"
ADDON_DIR="$HOME/.word_addons"
LEDGER_FILE="$HOME/.floppy_ledger"
VIRTUAL_IMG="$BANK_DIR/.virtual_floppy.img"
STATE_FILE="$HOME/.word_at_state"
TASK_DIR="/tmp/word_at_tasks"

ORANGE='\033[38;5;208m'
WHITE='\033[1;37m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Ensure critical directories exist
mkdir -p "$BANK_DIR/text" "$BANK_DIR/audio" "$BANK_DIR/images" "$BANK_DIR/video" "$BANK_DIR/games"
mkdir -p "$TASK_DIR" "$ADDON_DIR"
touch "$LEDGER_FILE" "$STATE_FILE"

source "$STATE_FILE" 2>/dev/null
[ -z "$ACTIVE_TARGET" ] && ACTIVE_TARGET="NONE"

# ==========================================
# HYPERVISOR & HELPERS
# ==========================================
press_enter() { echo -e "\n${WHITE}Press [ENTER] to continue...${NC}"; read -r; }
is_pkg_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "ok installed"; }

hypervisor_lock() {
    echo "$1|$2" > "$TASK_DIR/$$"
    for t in "$TASK_DIR"/*; do
        if [ -f "$t" ]; then
            t_pid=$(basename "$t")
            if [ "$t_pid" != "$$" ] && kill -0 "$t_pid" 2>/dev/null; then
                [ "$(cut -d'|' -f1 "$t")" -lt "$1" ] && pkill -P "$t_pid" -SIGUSR1 2>/dev/null
            else rm -f "$t" 2>/dev/null; fi
        fi
    done
}

hypervisor_release() {
    rm -f "$TASK_DIR/$$" 2>/dev/null
    local max_pri=0
    for t in "$TASK_DIR"/*; do
        if [ -f "$t" ]; then
            t_pri=$(cut -d'|' -f1 "$t")
            [ "$t_pri" -gt "$max_pri" ] && max_pri="$t_pri"
        fi
    done
    for t in "$TASK_DIR"/*; do
        if [ -f "$t" ] && kill -0 "$(basename "$t")" 2>/dev/null; then
            [ "$(cut -d'|' -f1 "$t")" -eq "$max_pri" ] && pkill -P "$(basename "$t")" -SIGUSR2 2>/dev/null
        fi
    done
}

# ==========================================
# THE SWITCHBOARD & ROUTING LOGIC
# ==========================================
case "$1" in

"")
        active_tasks=$(ls -1q "$TASK_DIR" 2>/dev/null | wc -l)
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} word@ SYSTEM KERNEL (v$KERNEL_VERSION)${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e " [PRODUCTIVITY] write, raw"
        echo -e " [MEDIA/HW]     ?rec, view, ?encode, ?decode"
        echo -e " [DISK/MEDIA]   ?scan, FTF, del!, ?flop"
        echo -e " [SYSTEM]       ?inst, theme, help!"
        echo -e "${ORANGE}========================================${NC}"
        
        if [ "$active_tasks" -gt 0 ]; then
            echo -e "${GREEN}[ONLINE]${NC} Tracking $active_tasks Background Process(es)"
        else
            echo -e "${WHITE}[IDLE]${NC} No background terminals detected."
        fi

        # Boot Background Math Daemon silently if not running
        if ! pgrep -f "word@ daemon" >/dev/null && is_pkg_installed "inotify-tools"; then
            bash "$0" daemon &
        fi
        exit 0
        ;;

    "daemon")
        # In-line math watcher for text files
        while true; do
            MODIFIED_FILE=$(inotifywait -q -e close_write --format '%w%f' "$BANK_DIR/text/" 2>/dev/null)
            if [[ "$MODIFIED_FILE" == *.txt ]]; then
                python3 -c "
import sys, re
try:
    with open(sys.argv[1], 'r') as f: content = f.read()
    matches = re.findall(r'pyth!\s*\[(.*?)\]\s*\?', content)
    if not matches: sys.exit(0)
    for expr in matches:
        try:
            clean = expr.replace('{','(').replace('}',')').replace('[','(').replace(']',')').replace('x','*').replace('^','**')
            res = eval(clean)
            if isinstance(res, float) and res.is_integer(): res = int(res)
            content = content.replace(f'pyth! [{expr}] ?', str(res))
        except: pass
    with open(sys.argv[1], 'w') as f: f.write(content)
except: pass
" "$MODIFIED_FILE"
            fi
        done
        ;;

"?inst")
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} PACKAGE MANAGER & APP STORE${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} [ SYSTEM CORE ]${NC}"
        echo -e "  1) Update OS Core      (Fetch latest word@ script)"
        echo -e "  2) Verify Dependencies (ffmpeg, w3m, mpv, etc.)"
        echo -e "\n${WHITE} [ OPTIONAL SOFTWARE ]${NC}"
        
        [ -f "$ADDON_DIR/word_ascii.py" ] && echo -e "  3) ASCII Video Engine      ${GREEN}[INSTALLED]${NC}" || echo -e "  3) ASCII Video Engine      ${RED}[MISSING]${NC}"
        [ -f "$ADDON_DIR/word_launcher.sh" ] && echo -e "  4) Software Launcher (run) ${GREEN}[INSTALLED]${NC}" || echo -e "  4) Software Launcher (run) ${RED}[MISSING]${NC}"
        [ -f "$ADDON_DIR/word_math.py" ] && echo -e "  5) Math Engine (?calc)     ${GREEN}[INSTALLED]${NC}" || echo -e "  5) Math Engine (?calc)     ${RED}[MISSING]${NC}"
        [ -f "$ADDON_DIR/word_web.sh" ] && echo -e "  6) Web Gateway (web)       ${GREEN}[INSTALLED]${NC}" || echo -e "  6) Web Gateway (web)       ${RED}[MISSING]${NC}"
        [ -f "$ADDON_DIR/word_brain.py" ] && echo -e "  7) Neural Core (brain)     ${GREEN}[INSTALLED]${NC}" || echo -e "  7) Neural Core (brain)     ${RED}[MISSING]${NC}"
        [ -f "$ADDON_DIR/word_game.py" ] && echo -e "  8) Sandbox Engine (terr@)  ${GREEN}[INSTALLED]${NC}" || echo -e "  8) Sandbox Engine (terr@)  ${RED}[MISSING]${NC}"
        
        echo -e "\n  q) Quit"
        read -p " Select target (1-8): " inst_choice

        case "$inst_choice" in
            1)
                echo -e "${WHITE}Fetching latest OS Core from GitHub...${NC}"
                if sudo curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word@?$(date +%s)" -o /usr/local/bin/word@; then
                    sudo chmod +x /usr/local/bin/word@
                    echo -e "${GREEN}OS Core successfully updated! Restart word@ to apply changes.${NC}"
                else
                    echo -e "${RED}Update failed. Check network connection.${NC}"
                fi
                press_enter ;;
            2)
                echo -e "${WHITE}Installing OS packages...${NC}"
                sudo apt-get update -qq
                sudo apt-get install -y python3 curl ffmpeg mpg123 alsa-utils inotify-tools dosfstools imagemagick python3-opencv v4l-utils w3m mpv minimodem
                pip3 install sstv --break-system-packages 2>/dev/null || pip install sstv
                echo -e "${GREEN}Dependencies met.${NC}"
                press_enter ;;
            3)
                echo -e "${WHITE}Downloading ASCII Video Engine...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_ascii.py?$(date +%s)" -o "$ADDON_DIR/word_ascii.py"; then
                    echo -e "${GREEN}ASCII Video Engine installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            4)
                echo -e "${WHITE}Downloading Software Launcher...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_launcher.sh?$(date +%s)" -o "$ADDON_DIR/word_launcher.sh"; then
                    chmod +x "$ADDON_DIR/word_launcher.sh"
                    echo -e "${GREEN}Software Launcher installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            5)
                echo -e "${WHITE}Downloading Math Engine...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_math.py?$(date +%s)" -o "$ADDON_DIR/word_math.py"; then
                    echo -e "${GREEN}Math Engine installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            6)
                echo -e "${WHITE}Downloading Web Gateway...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_web.sh?$(date +%s)" -o "$ADDON_DIR/word_web.sh"; then
                    chmod +x "$ADDON_DIR/word_web.sh"
                    echo -e "${GREEN}Web Gateway installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            7)
                echo -e "${WHITE}Downloading Neural Core...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_brain.py?$(date +%s)" -o "$ADDON_DIR/word_brain.py"; then
                    echo -e "${GREEN}Neural Core installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            8)
                echo -e "${WHITE}Downloading terr@...${NC}"
                if curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word_game.py?$(date +%s)" -o "$ADDON_DIR/word_game.py"; then
                    echo -e "${GREEN}terr@ installed!${NC}"
                else
                    echo -e "${RED}Download failed.${NC}"
                fi
                press_enter ;;
            *) ;;
        esac
        exit 0
        ;;

    "help!")
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} word@ SYSTEM MANUAL${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${GREEN} [ PRODUCTIVITY ]${NC}"
        echo -e "  write [name] : Standard text editor (Nano/GUI)."
        echo -e "  raw [name]   : Distraction-free logger with inline math."
        
        echo -e "\n${GREEN} [ MEDIA & HARDWARE ]${NC}"
        echo -e "  view         : Open media viewer (Audio, Video, ASCII)."
        echo -e "  ?rec         : Record audio/video directly to Bank."
        echo -e "  ?encode      : Convert formats (Image->SSTV, Text->Audio, File->Base64)."
        echo -e "  ?decode      : Recover files from acoustic or cipher formats."
        
        echo -e "\n${GREEN} [ DISK MANAGEMENT ]${NC}"
        echo -e "  ?scan        : Find and mount external USB/Floppy drives."
        echo -e "  FTF          : File-To-Floppy. Compress and transfer banks."
        echo -e "  ?flop        : Initialize virtual floppy emulation."
        echo -e "  del!         : Secure deletion and disk formatting."
        
        echo -e "\n${GREEN} [ SYSTEM CORE ]${NC}"
        echo -e "  ?inst        : Open the App Store to download Addons & Updates."
        echo -e "  theme        : Toggle pure black terminal background globally."
        echo -e "${ORANGE}========================================${NC}"
        press_enter
        exit 0
        ;;

    "theme")
        if grep -q "word_bg_override" "$HOME/.bashrc"; then
            sed -i '/word_bg_override/d' "$HOME/.bashrc"
            echo -en "\033]11;#300A24\007"
            echo -e "${WHITE}Theme reverted to Ubuntu default.${NC}"
        else
            echo 'echo -en "\033]11;#000000\007" # word_bg_override' >> "$HOME/.bashrc"
            echo -en "\033]11;#000000\007"
            echo -e "${GREEN}Pure Black Theme applied globally.${NC}"
        fi
        exit 0
        ;;

    "write"|"raw")
        if [ "$1" == "write" ]; then
            [ -n "$2" ] && filename="$2" || read -p "Enter document name: " filename
            filepath="$BANK_DIR/text/$filename.txt"
            touch "$filepath"
            if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then xdg-open "$filepath" 2>/dev/null || nano "$filepath"
            else nano "$filepath"; fi
        else
            [ -n "$2" ] && filename="$2" || read -p "Enter document name: " filename
            TEMP_FILE="$BANK_DIR/text/.$filename.tmp"
            FINAL_FILE="$BANK_DIR/text/$filename.txt"
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} RAW WRITING MODE (Math Enabled)${NC}"
            echo -e "${ORANGE} Type //SAVE to keep, //REJECT to burn."
            echo -e " Inline Math: pyth! [ 2+2 ] ?${NC}"
            echo -e "${ORANGE}========================================${NC}"
            > "$TEMP_FILE"
            while IFS= read -r line; do
                if [[ "$line" == "//SAVE" ]]; then
                    mv "$TEMP_FILE" "$FINAL_FILE"; echo -e "${WHITE}Draft secured.${NC}"; exit 0
                elif [[ "$line" == "//REJECT" ]]; then
                    rm -f "$TEMP_FILE"; echo -e "${RED}Burned.${NC}"; exit 0
                else
                    echo "$line" >> "$TEMP_FILE"
                    cp "$TEMP_FILE" "$FINAL_FILE" 2>/dev/null # Triggers daemon live
                fi
            done
        fi
        exit 0
        ;;

"view")
        hypervisor_lock 3 "Media Viewer"
        if [ -z "$2" ]; then
            # Added nocaseglob to catch .JPG or .jpg, and expanded the search parameters
            shopt -s nullglob nocaseglob
            media_files=("$BANK_DIR"/video/*.mp4 "$BANK_DIR"/video/*.webm "$BANK_DIR"/audio/*.mp3 "$BANK_DIR"/images/*.jpg "$BANK_DIR"/images/*.jpeg "$BANK_DIR"/images/*.png "$BANK_DIR"/text/*.txt)
            [ -d "$ACTIVE_TARGET" ] && media_files+=("$ACTIVE_TARGET"/*.mp4 "$ACTIVE_TARGET"/*.webm "$ACTIVE_TARGET"/*.mp3 "$ACTIVE_TARGET"/*.jpg "$ACTIVE_TARGET"/*.jpeg "$ACTIVE_TARGET"/*.png "$ACTIVE_TARGET"/*.txt)
            shopt -u nullglob nocaseglob

            if [ ${#media_files[@]} -eq 0 ]; then echo -e "${RED}No media found.${NC}"; hypervisor_release; exit 1; fi

            i=1
            for m in "${media_files[@]}"; do
                echo -e "  ${WHITE}$i)${NC} $(basename "$m")"
                ((i++))
            done
            read -p "Select file to view: " m_choice
            FILE_PATH="${media_files[$((m_choice-1))]}"
            target=$(basename "$FILE_PATH")
        else
            target="$2"
            FILE_PATH=$(find "$BANK_DIR" "$ACTIVE_TARGET" -name "$target" 2>/dev/null | head -n 1)
        fi

        if [[ "$FILE_PATH" == *.mp3 ]]; then
            echo -e "${WHITE}Playing Audio: $target${NC}"
            mpg123 -q "$FILE_PATH" 2>/dev/null
            
        elif [[ "$FILE_PATH" == *.txt ]]; then
            echo -e "${WHITE}Reading Text: $target${NC}"
            # Uses less for clean terminal reading
            less "$FILE_PATH"
            
        elif [[ "$FILE_PATH" == *.jpg || "$FILE_PATH" == *.jpeg || "$FILE_PATH" == *.png ]]; then
            echo -e "${WHITE}Viewing Image: $target${NC}"
            # Tries terminal image viewers first, falls back to GUI if available
            if command -v chafa >/dev/null 2>&1; then chafa "$FILE_PATH"
            elif command -v catimg >/dev/null 2>&1; then catimg "$FILE_PATH"
            elif [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then xdg-open "$FILE_PATH" 2>/dev/null
            else echo -e "${RED}No viewer found! Run 'sudo apt install chafa' for terminal images.${NC}"; fi
            
        elif [[ "$FILE_PATH" == *.mp4 || "$FILE_PATH" == *.webm ]]; then
            echo -e "${ORANGE}========================================${NC}"
            echo -e "  1) Standard Video (GUI Player)"
            if [ -f "$ADDON_DIR/word_ascii.py" ]; then
                echo -e "  2) ASCII Render   (Terminal Player)"
            else
                echo -e "  ${RED}2) ASCII Render   [REQUIRES ADDON - Run ?inst]${NC}"
            fi
            read -p " Select Mode: " vid_mode

            if [[ "$vid_mode" == "1" ]]; then
                # Standard playback
                mpv --quiet "$FILE_PATH" >/dev/null 2>&1
            elif [[ "$vid_mode" == "2" ]]; then
                if [ -f "$ADDON_DIR/word_ascii.py" ]; then
                    SUB_PATH="${FILE_PATH%.*}.txt"
                    
                    # 1. Spawn audio in the background and freeze it
                    mpv --no-video --quiet "$FILE_PATH" >/dev/null 2>&1 &
                    AUDIO_PID=$!
                    sleep 0.1
                    kill -STOP $AUDIO_PID 2>/dev/null
                    
                    # 2. Trap for clean exit if you hit Ctrl+C
                    trap 'kill -9 $AUDIO_PID $WATCHER_PID 2>/dev/null; hypervisor_release; exit 0' INT
                    
                    # 3. Smart Sync 3.0: Process State Tracker (UNTOUCHED)
                    (
                        sleep 0.5
                        PY_PID=$(pgrep -n -f "word_ascii.py")
                        if [ -n "$PY_PID" ]; then
                            SLEEP_COUNT=0
                            while kill -0 "$PY_PID" 2>/dev/null; do
                                STAT=$(ps -p "$PY_PID" -o stat= 2>/dev/null)
                                if [[ "$STAT" == S* ]]; then
                                    ((SLEEP_COUNT++))
                                else
                                    if [ "$SLEEP_COUNT" -ge 4 ]; then
                                        kill -CONT $AUDIO_PID 2>/dev/null
                                        break
                                    fi
                                    SLEEP_COUNT=0
                                fi
                                sleep 0.1
                            done
                        fi
                    ) >/dev/null 2>&1 &
                    WATCHER_PID=$!
                    disown $WATCHER_PID 2>/dev/null
                    
                    # 4. Run the visual ASCII engine
                    python3 "$ADDON_DIR/word_ascii.py" "$FILE_PATH" "$SUB_PATH"
                    
                    # 5. Cleanup silently when finished
                    kill -9 $AUDIO_PID 2>/dev/null
                    kill -9 $WATCHER_PID 2>/dev/null
                    trap - INT
                else
                    echo -e "${RED}Addon missing! Use ?inst to download it.${NC}"
                fi
            fi
        fi
        hypervisor_release
        ;;

"run"|"?calc"|"web"|"brain"|"terr@")
        if [ "$1" == "run" ] && [ -f "$ADDON_DIR/word_launcher.sh" ]; then
            bash "$ADDON_DIR/word_launcher.sh"
        elif [ "$1" == "?calc" ] && [ -f "$ADDON_DIR/word_math.py" ]; then
            python3 "$ADDON_DIR/word_math.py"
        elif [ "$1" == "web" ] && [ -f "$ADDON_DIR/word_web.sh" ]; then
            bash "$ADDON_DIR/word_web.sh"
        elif [ "$1" == "brain" ] && [ -f "$ADDON_DIR/word_brain.py" ]; then
            python3 "$ADDON_DIR/word_brain.py"
        elif [ "$1" == "terr@" ] && [ -f "$ADDON_DIR/word_game.py" ]; then
            python3 "$ADDON_DIR/word_game.py"
        else
            echo -e "${RED}Software missing! Run 'word@ ?inst' to download this feature.${NC}"
        fi
        exit 0
        ;;

"?scan"|"del!"|"?flop"|"?rec"|"FTF"|"?work"|"?gath"|"?encode"|"?decode")
        # ---------------------------------------------------------
        # THE HARDWARE, MEDIA & ENCODING BLOCK
        # ---------------------------------------------------------
        case "$1" in
            "?scan")
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} PHYSICAL MEDIA SCANNER${NC}"
                echo -e "${ORANGE}========================================${NC}"
                
                # Simplified check for standard fd0 or USB floppy (sdX)
                FLOPPY_DEV=$(lsblk -ndo NAME,TYPE | awk '$2=="disk" {print $1}' | grep -E "fd0|sd[b-z]" | head -n 1)
                
                if [ -z "$FLOPPY_DEV" ]; then 
                    echo -e "${RED}[ERROR] No floppy drive detected.${NC}"
                else
                    echo -e "${GREEN}[OK] Drive detected at /dev/$FLOPPY_DEV.${NC}"
                    echo -e "${WHITE}Running magnetic sector health check...${NC}"
                    
                    # Non-destructive read test
                    if sudo badblocks -sv "/dev/$FLOPPY_DEV" -b 512 -c 1 > /dev/null 2>&1; then
                        echo -e "${GREEN}[HEALTHY] Disk sectors intact.${NC}"
                        # In the future, we hook this into $LEDGER_FILE with the NATO name
                    else
                        echo -e "${RED}[WARNING] Bad sectors detected! Media is degrading. Back up immediately.${NC}"
                    fi
                fi
                press_enter
                ;;
                
            "?rec")
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} word@ MEDIA RECORDER (Floppy-Optimized)${NC}"
                echo -e "${ORANGE}========================================${NC}"
                echo -e " 1) Audio Log (8kbps MP3 - ~60KB/min)"
                echo -e " 2) Video Log (10fps WebM - ~1MB/min)"
                read -p " Select Mode: " rec_choice
                read -p " Enter filename: " rec_name
                
                if [ "$rec_choice" == "1" ]; then
                    echo -e "${RED}[REC] Press Ctrl+C to stop recording.${NC}"
                    # Aggressive audio compression to ensure it fits on a floppy
                    ffmpeg -f alsa -i default -codec:a libmp3lame -b:a 8k -ar 11025 "$BANK_DIR/audio/$rec_name.mp3"
                elif [ "$rec_choice" == "2" ]; then
                    echo -e "${RED}[REC] Press Ctrl+C to stop recording.${NC}"
                    # Tiny resolution, low framerate video blog
                    ffmpeg -f v4l2 -i /dev/video0 -f alsa -i default -c:v libvpx -b:v 100K -r 10 -s 320x240 -c:a libvorbis -b:a 16k "$BANK_DIR/video/$rec_name.webm"
                fi
                echo -e "${GREEN}Saved to word_at_bank. Ready for FTF.${NC}"
                press_enter
                ;;
                
            "FTF")
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} FILE-TO-FLOPPY COMPRESSION ENGINE${NC}"
                echo -e "${ORANGE}========================================${NC}"
                read -p " Enter full path of target file: " target_file
                
                if [ ! -f "$target_file" ]; then echo -e "${RED}File not found.${NC}"; exit 1; fi
                
                FILE_SIZE=$(stat -c%s "$target_file")
                echo -e "Original Size: $((FILE_SIZE / 1024)) KB"
                
                EXT="${target_file##*.}"
                OUT_FILE="/tmp/$(basename "$target_file")"
                
                # Route the file to the correct FFmpeg/ImageMagick cruncher
                if [[ "$EXT" == "mp4" || "$EXT" == "webm" ]]; then
                    echo -e "${WHITE}Crunching Video to < 1.4MB target...${NC}"
                    ffmpeg -i "$target_file" -c:v libx264 -crf 35 -preset veryslow -b:v 150k -c:a aac -b:a 16k -s 320x240 "$OUT_FILE.mp4" -y
                elif [[ "$EXT" == "jpg" || "$EXT" == "png" ]]; then
                    echo -e "${WHITE}Crunching Image...${NC}"
                    convert "$target_file" -resize 800x800\> -quality 30 "$OUT_FILE.jpg"
                elif [[ "$EXT" == "wav" || "$EXT" == "mp3" ]]; then
                    echo -e "${WHITE}Crunching Audio...${NC}"
                    ffmpeg -i "$target_file" -codec:a libmp3lame -b:a 16k "$OUT_FILE.mp3" -y
                else
                    echo -e "${WHITE}Archiving text/data...${NC}"
                    tar -czf "$OUT_FILE.tar.gz" -C "$(dirname "$target_file")" "$(basename "$target_file")"
                fi
                echo -e "${GREEN}Compression complete. Ready for physical transfer.${NC}"
                press_enter
                ;;
                
           "?encode")
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} CROSS-FORMAT ENCODING ENGINE${NC}"
                echo -e "${ORANGE}========================================${NC}"
                echo -e " 1) Image (.jpg/.png) -> SSTV Audio Waveform (.wav)"
                echo -e " 2) Text/Data (.txt)  -> Acoustic Modem Audio (.wav)"
                echo -e " 3) Any File          -> Base64 Text Cipher (.txt)"
                read -p " Select Mode (1-3): " enc_choice
                
                shopt -s nullglob nocaseglob
                enc_files=()
                
                # Filter what files to show based on the mode selected
                if [ "$enc_choice" == "1" ]; then
                    enc_files=("$BANK_DIR"/images/*.jpg "$BANK_DIR"/images/*.jpeg "$BANK_DIR"/images/*.png)
                    [ -d "$ACTIVE_TARGET" ] && enc_files+=("$ACTIVE_TARGET"/*.jpg "$ACTIVE_TARGET"/*.jpeg "$ACTIVE_TARGET"/*.png)
                elif [ "$enc_choice" == "2" ]; then
                    enc_files=("$BANK_DIR"/text/*.txt)
                    [ -d "$ACTIVE_TARGET" ] && enc_files+=("$ACTIVE_TARGET"/*.txt)
                elif [ "$enc_choice" == "3" ]; then
                    enc_files=("$BANK_DIR"/images/* "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/video/*)
                    [ -d "$ACTIVE_TARGET" ] && enc_files+=("$ACTIVE_TARGET"/*)
                else
                    echo -e "${RED}Invalid selection.${NC}"; shopt -u nullglob nocaseglob; press_enter; exit 1
                fi
                shopt -u nullglob nocaseglob
                
                # Build a clean list of only valid files
                valid_enc=()
                for f in "${enc_files[@]}"; do [ -f "$f" ] && valid_enc+=("$f"); done
                
                if [ ${#valid_enc[@]} -eq 0 ]; then
                    echo -e "${RED}No compatible files found for this mode.${NC}"
                else
                    i=1
                    for f in "${valid_enc[@]}"; do
                        echo -e "  ${WHITE}$i)${NC} $(basename "$f")"
                        ((i++))
                    done
                    
                    read -p " Select file (1-$((i-1))): " f_choice
                    enc_file="${valid_enc[$((f_choice-1))]}"
                    
                    if [ ! -f "$enc_file" ]; then echo -e "${RED}Invalid selection.${NC}"; press_enter; exit 1; fi
                    
                    OUT_NAME=$(basename "$enc_file" | cut -d. -f1)
                    
                    if [ "$enc_choice" == "1" ]; then
                        echo -e "${WHITE}Modulating image into SSTV frequencies (Martin1)...${NC}"
                        if command -v sstv >/dev/null 2>&1 || python3 -m sstv -h >/dev/null 2>&1; then
                            # ImageMagick forces everything into a standardized temp jpg to prevent format errors
                            convert "$enc_file" -resize 320x256\! /tmp/sstv_temp.jpg
                            python3 -m sstv --mode Martin1 /tmp/sstv_temp.jpg "$BANK_DIR/audio/${OUT_NAME}_sstv.wav"
                            rm -f /tmp/sstv_temp.jpg
                            echo -e "${GREEN}Encoded to $BANK_DIR/audio/${OUT_NAME}_sstv.wav${NC}"
                        else
                            echo -e "${RED}[ERROR] Python sstv missing. Run '?inst' Option 2.${NC}"
                        fi
                    elif [ "$enc_choice" == "2" ]; then
                        echo -e "${WHITE}Modulating text into audio frequencies...${NC}"
                        if command -v minimodem >/dev/null 2>&1; then
                            minimodem --tx -f "$BANK_DIR/audio/${OUT_NAME}_modem.wav" rtty < "$enc_file"
                            echo -e "${GREEN}Encoded to $BANK_DIR/audio/${OUT_NAME}_modem.wav${NC}"
                        else
                            echo -e "${RED}[ERROR] 'minimodem' missing. Run '?inst' Option 2.${NC}"
                        fi
                    elif [ "$enc_choice" == "3" ]; then
                        echo -e "${WHITE}Converting to Base64 Cipher...${NC}"
                        base64 "$enc_file" > "$BANK_DIR/text/${OUT_NAME}_cipher.txt"
                        echo -e "${GREEN}Encoded to $BANK_DIR/text/${OUT_NAME}_cipher.txt${NC}"
                    fi
                fi
                press_enter
                ;;
                
            "?decode")
                clear
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} CROSS-FORMAT DECODING ENGINE${NC}"
                echo -e "${ORANGE}========================================${NC}"
                echo -e " 1) Acoustic Modem Audio (.wav) -> Text/Data (.txt)"
                echo -e " 2) Base64 Text Cipher (.txt)   -> Original File"
                read -p " Select Mode (1-2): " dec_choice
                
                shopt -s nullglob nocaseglob
                dec_files=()
                
                if [ "$dec_choice" == "1" ]; then
                    dec_files=("$BANK_DIR"/audio/*.wav)
                    [ -d "$ACTIVE_TARGET" ] && dec_files+=("$ACTIVE_TARGET"/*.wav)
                elif [ "$dec_choice" == "2" ]; then
                    dec_files=("$BANK_DIR"/text/*.txt)
                    [ -d "$ACTIVE_TARGET" ] && dec_files+=("$ACTIVE_TARGET"/*.txt)
                else
                    echo -e "${RED}Invalid selection.${NC}"; shopt -u nullglob nocaseglob; press_enter; exit 1
                fi
                shopt -u nullglob nocaseglob
                
                valid_dec=()
                for f in "${dec_files[@]}"; do [ -f "$f" ] && valid_dec+=("$f"); done
                
                if [ ${#valid_dec[@]} -eq 0 ]; then
                    echo -e "${RED}No compatible files found for decoding.${NC}"
                else
                    i=1
                    for f in "${valid_dec[@]}"; do
                        echo -e "  ${WHITE}$i)${NC} $(basename "$f")"
                        ((i++))
                    done
                    
                    read -p " Select file (1-$((i-1))): " f_choice
                    dec_file="${valid_dec[$((f_choice-1))]}"
                    
                    if [ ! -f "$dec_file" ]; then echo -e "${RED}Invalid selection.${NC}"; press_enter; exit 1; fi
                    
                    OUT_NAME=$(basename "$dec_file" | cut -d. -f1)
                    
                    if [ "$dec_choice" == "1" ]; then
                        echo -e "${WHITE}Demodulating acoustic data...${NC}"
                        if command -v minimodem >/dev/null 2>&1; then
                            minimodem --rx -f "$dec_file" rtty > "$BANK_DIR/text/${OUT_NAME}_decoded.txt"
                            echo -e "${GREEN}Decoded to $BANK_DIR/text/${OUT_NAME}_decoded.txt${NC}"
                        else
                             echo -e "${RED}[ERROR] 'minimodem' missing. Run '?inst' Option 2.${NC}"
                        fi
                    elif [ "$dec_choice" == "2" ]; then
                        echo -e "${WHITE}Decoding Base64 Cipher...${NC}"
                        read -p " Enter original file extension (e.g., jpg, mp4, txt): " ext
                        base64 -d "$dec_file" > "$BANK_DIR/text/${OUT_NAME}_decoded.$ext"
                        echo -e "${GREEN}Decoded to $BANK_DIR/text/${OUT_NAME}_decoded.$ext${NC}"
                    fi
                fi
                press_enter
                ;;
                
            *)
                echo -e "${RED}Hardware module '$1' is currently unassigned or missing.${NC}"
                press_enter
                ;;
        esac
        ;;

    *)
        echo -e "${RED}Unknown command. Type 'word@ help!' for the manual.${NC}"
        ;;
esac
