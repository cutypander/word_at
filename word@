            echo -e "  Hardware Status : ${WHITE}[FLOPPY DRIVE ACTIVE]${NC}"
        else
            echo -e "  Hardware Status : ${RED}[NO DISK MOUNTED]${NC}"
        fi
        echo ""
        
        echo -e "${ORANGE}To see the available commands, type: ${WHITE}word@ help!${NC}"
        echo -e "${ORANGE}========================================${NC}"
        exit 0
        ;;

    "help!")
        clear 
        if [ "$2" == "tree" ]; then
            echo -e "${WHITE}SYSTEM HIERARCHY:${NC}"
            echo -e "${ORANGE}word@${NC}"
            echo -e "├── help!"
            echo -e "│   ├── tree (Visual structure)"
            echo -e "│   └── desc (Detailed manual)"
            echo -e "├── write [filename]"
            echo -e "├── raw [filename]"
            echo -e "├── ?rec"
            echo -e "├── view [target]"
            echo -e "├── ?play (Game Console)"
            echo -e "├── FTF (File To Floppy Archive Suite)"
            echo -e "│   ├── 1) Text (.txt)"
            echo -e "│   ├── 2) Sound (.mp3)"
            echo -e "│   ├── 3) Images (.jpg/.png)"
            echo -e "│   └── 4) Games (.py)"
            echo -e "├── init"
            echo -e "├── ?calc"
            echo -e "├── ?inst (Package Manager & GitHub Fetcher)"
            echo -e "├── ?scan"
            echo -e "├── del!"
            echo -e "├── ?flop / ?gath / ?when / ?work"
            echo -e "└── update"
            
        elif [ "$2" == "desc" ]; then
            echo -e "${WHITE}DETAILED COMMAND DESCRIPTIONS:${NC}"
            echo -e "${ORANGE}write [filename]${NC} - Opens or creates a text file. Automatically routes to GUI or Nano."
            echo -e "${ORANGE}raw [filename]${NC}   - Distraction-free terminal writing mode. Type //SAVE or //REJECT."
            echo -e "${ORANGE}?rec${NC}             - Audio field recorder. Compresses live mic input to MP3."
            echo -e "${ORANGE}FTF${NC}              - File To Floppy. Unified archiver for text, compressed audio, images, and games."
            echo -e "${ORANGE}view [target]${NC}    - Universal media viewer for streaming text or playing audio."
            echo -e "${ORANGE}?play${NC}            - Game Console. Launches Python cartridges from bank or floppy."
            echo -e "${ORANGE}?calc${NC}            - Floating-point math calculator powered by background Python."
            echo -e "${ORANGE}?inst${NC}            - Package Manager. Installs dependencies or pulls code directly from GitHub."
            echo -e "${ORANGE}?scan${NC}            - Diagnostic suite for magnetic surface checks, hunting, and virtual emulation."
            echo -e "${ORANGE}del!${NC}             - Burn protocols to safely erase files, banks, or virtual floppies."
            echo -e "${ORANGE}init${NC}             - Initializes a floppy disk, assigning a NATO name and scanning sectors."
            echo -e "${ORANGE}update${NC}           - Pulls the latest word@ script from GitHub."
            
        else
            echo -e "${WHITE}QUICK REFERENCE:${NC}"
            echo -e "  ${WHITE}write${NC}     - Open/create text (Nano/Desktop)"
            echo -e "  ${WHITE}raw${NC}       - Write directly in terminal"
            echo -e "  ${WHITE}?rec${NC}      - Record MP3 audio"
            echo -e "  ${WHITE}FTF${NC}       - File to Floppy (Text/Sound/Image/Game)"
            echo -e "  ${WHITE}view${NC}      - Play MP3 or stream text"
            echo -e "  ${WHITE}?play${NC}     - Launch Python terminal games"
            echo -e "  ${WHITE}?calc${NC}     - Python-powered Math Engine"
            echo -e "  ${WHITE}?inst${NC}     - Package Manager & GitHub Fetcher"
            echo -e "  ${WHITE}?scan${NC}     - Tools (Surface, Hunt, Ledger, Emulator Boot)"
            echo -e "  ${WHITE}del!${NC}      - Erase (File, Bank, Floppy, Virtual, Reset)"
            echo -e "  ${WHITE}init${NC}      - Format and stamp floppy"
            echo -e "  ${WHITE}?flop${NC}     - Floppy drive hardware status"
            echo -e "  ${WHITE}?gath${NC}     - WordBank file sizes/weights"
            echo -e "  ${WHITE}?when${NC}     - Global file timestamps"
            echo -e "  ${WHITE}?work${NC}     - Health & network diagnostic check"
            echo -e "  ${WHITE}update${NC}    - Pull latest version from GitHub"
            echo -e "  ${WHITE}help!${NC}     - Options: 'help! tree' or 'help! desc'"
        fi
        exit 0
        ;;

    "?inst")
        installer_module
        exit 0
        ;;

    "FTF")
        file_to_floppy_module
        exit 0
        ;;

    "write")
        if [ -n "$2" ]; then
            filename="$2"
        else
            read -p "Enter document name: " filename
        fi
        filepath="$BANK_DIR/text/$filename.txt"
        touch "$filepath"
        
        if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$filepath" 2>/dev/null || nano "$filepath"
        else
            nano "$filepath"
        fi
        exit 0
        ;;

    "raw")
        if [ -n "$2" ]; then
            filename="$2"
        else
            read -p "Enter document name: " filename
        fi
        
        TEMP_FILE="$BANK_DIR/text/.$filename.tmp"
        FINAL_FILE="$BANK_DIR/text/$filename.txt"
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} RAW WRITING MODE ENGAGED${NC}"
        echo -e "${ORANGE} Type //SAVE on a new line to keep your work."
        echo -e " Type //REJECT on a new line to burn it.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        > "$TEMP_FILE"
        
        while IFS= read -r line; do
            if [[ "$line" == "//SAVE" ]]; then
                mv "$TEMP_FILE" "$FINAL_FILE"
                echo -e "${WHITE}Draft secured in Bank as $filename.txt${NC}"
                exit 0
            elif [[ "$line" == "//REJECT" ]]; then
                rm -f "$TEMP_FILE"
                echo -e "${RED}Draft rejected. Burned to ash.${NC}"
                exit 0
            else
                echo "$line" >> "$TEMP_FILE"
            fi
        done
        ;;

    "?rec")
        if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v arecord >/dev/null 2>&1; then
            echo -e "${RED}Relevant tools missing. Run 'word@ ?inst' to resolve.${NC}"
            exit 1
        fi
        
        read -p "Enter a name for this recording: " rec_name
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} LIVE AUDIO RECORDING${NC}"
        echo -e "${ORANGE} Press [ENTER] to stop recording.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        TEMP_WAV="$BANK_DIR/audio/.$rec_name.tmp.wav"
        FINAL_MP3="$BANK_DIR/audio/$rec_name.mp3"
        
        arecord -f cd "$TEMP_WAV" -q &
        RECORD_PID=$!
        
        read -r
        kill $RECORD_PID 2>/dev/null
        
        echo -e "${WHITE}Processing audio...${NC}"
        if ffmpeg -y -i "$TEMP_WAV" -qscale:a 2 "$FINAL_MP3" 2>/dev/null; then
            rm -f "$TEMP_WAV"
            echo -e "${GREEN}Recording saved to WordBank as $rec_name.mp3${NC}"
        else
            echo -e "${RED}Error: Audio processing failed.${NC}"
        fi
        exit 0
        ;;

    "init")
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: No disk inserted to initialize.${NC}"
            exit 1
        fi
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE}   INITIALIZING NEW FLOPPY HARDWARE${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        NEW_ID=$(tr -dc A-Z0-9 </dev/urandom | head -c 6)
        WORD1=${NATO[$RANDOM % 26]}
        if grep -q "NAME: $WORD1" "$LEDGER_FILE"; then
            WORD2=${NATO[$RANDOM % 26]}
            DISK_NAME="$WORD1-$WORD2"
        else
            DISK_NAME="$WORD1"
        fi
        
        echo "$NEW_ID" > "$FLOPPY_DIR/.disk_id"
        echo -e "${WHITE}Hardware Stamped. Assigned Name: $DISK_NAME${NC}"
        
        echo -e "${ORANGE}Running deep magnetic scan...${NC}"
        DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
        
        if [[ "$DEVICE" == *loop* ]] || [ ! -b "$DEVICE" ]; then
            BAD_COUNT=0
            echo -e "${GREEN}Virtual Floppy Image detected. Surface integrity is 100%.${NC}"
        else
            BAD_COUNT=$(sudo badblocks -q "$DEVICE" | wc -l)
            if [ "$BAD_COUNT" -gt 0 ]; then
                echo -e "${RED}WARNING: $BAD_COUNT dead sectors detected.${NC}"
            else
                echo -e "${GREEN}Scan complete. Surface integrity is 100%.${NC}"
            fi
        fi
        
        echo "ID: $NEW_ID | NAME: $DISK_NAME | BAD_BLOCKS: $BAD_COUNT" >> "$LEDGER_FILE"
        echo -e "${GREEN}Disk successfully integrated into the ecosystem.${NC}"
        exit 0
        ;;

    "?calc")
        calculator_engine
        ;;

    "?play")
        if ! command -v python3 >/dev/null 2>&1; then
            echo -e "${RED}Error: python3 is missing. Run 'word@ ?inst' to resolve.${NC}"
            exit 1
        fi

        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} word@ GAME CONSOLE${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        shopt -s nullglob
        bank_games=("$BANK_DIR"/games/*.py)
        floppy_games=("$FLOPPY_DIR"/*.py)
        shopt -u nullglob
        
        all_games=("${bank_games[@]}" "${floppy_games[@]}")
        
        if [ ${#all_games[@]} -eq 0 ]; then
            echo -e "${RED}No games found in Local Bank or Floppy Drive.${NC}"
            exit 1
        fi
        
        i=1
        for g in "${all_games[@]}"; do
            basename=$(basename "$g")
            location="Bank"
            [[ "$g" == "$FLOPPY_DIR"* ]] && location="Floppy Disk"
            echo -e "  ${WHITE}$i)${NC} $basename ${ORANGE}[$location]${NC}"
            ((i++))
        done
        
        echo -e "${ORANGE}----------------------------------------${NC}"
        read -p " Select game to boot (or 'q' to quit): " choice
        
        if [[ "$choice" == "q" || "$choice" == "Q" ]]; then
            echo -e "${WHITE}Exiting console...${NC}"
            exit 0
        fi
        
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#all_games[@]}" ]; then
            echo -e "${RED}Invalid selection.${NC}"
            exit 1
        fi
        
        SELECTED_GAME="${all_games[$((choice-1))]}"
        
        clear
        python3 "$SELECTED_GAME"
        
        clear
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} Game session ended. OS control restored.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        exit 0
        ;;

    "?scan")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} ADVANCED SCANNER PROTOCOLS${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "  ${WHITE}1)${NC} Surface Scan (Check magnetic integrity)"
        echo -e "  ${WHITE}2)${NC} Local Hunt   (Search Pi and move to Bank)"
        echo -e "  ${WHITE}3)${NC} Ledger Scan  (Find a file's physical disk)"
        echo -e "  ${WHITE}4)${NC} Auto-Execute (Trigger .autorun or script)"
        echo -e "  ${WHITE}5)${NC} Boot Virtual Floppy Emulator"
        echo -e "${ORANGE}========================================${NC}"
        read -p "Select protocol (1-5): " scan_choice

        case "$scan_choice" in
            1)
                if mountpoint -q "$FLOPPY_DIR" 2>/dev/null; then
                    DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
                    if [[ "$DEVICE" == *loop* ]] || [ ! -b "$DEVICE" ]; then
                        echo -e "${ORANGE}Listening for dead sectors... wait, can you hear it step? Yeah, me neither.${NC}"
                        echo -e "${GREEN}Virtual Floppy Image detected. Magnetic integrity is artificially 100%.${NC}"
                    else
                        echo -e "${ORANGE}Listening for dead sectors on $DEVICE...${NC}"
                        sudo badblocks -v "$DEVICE"
                    fi
                else
                    echo -e "${RED}No floppy drive mounted at $FLOPPY_DIR.${NC}"
                fi
                ;;
            2)
                read -p "Enter exact filename to hunt: " hunt_target
                echo -e "${ORANGE}Sweeping local system...${NC}"
                FOUND_PATH=$(find "$HOME" -type f -name "$hunt_target" 2>/dev/null | head -n 1)
                
                if [ -n "$FOUND_PATH" ]; then
                    echo -e "${WHITE}Target acquired at: $FOUND_PATH${NC}"
                    read -p "Import to WordBank? (Y/N): " import_choice
                    if [[ "${import_choice,,}" == "y" ]]; then
                        cp "$FOUND_PATH" "$BANK_DIR/"
                    fi
                else
                    echo -e "${RED}File not found on local system.${NC}"
                fi
                ;;
            3)
                read -p "Enter document name to locate: " doc_target
                if grep -q "FILE: $doc_target" "$LEDGER_FILE"; then
                    grep "FILE: $doc_target" "$LEDGER_FILE"
                else
                    echo -e "${RED}Document not found in physical archives.${NC}"
                fi
                ;;
            4)
                if [ -d "$FLOPPY_DIR" ]; then
                    if [ -f "$FLOPPY_DIR/.autorun" ]; then
                        AUTORUN_FILE=$(cat "$FLOPPY_DIR/.autorun")
                        if [ -f "$FLOPPY_DIR/$AUTORUN_FILE" ]; then
                            echo -e "${WHITE}Auto-Run triggered: $AUTORUN_FILE${NC}"
                            if [[ "$AUTORUN_FILE" == *.py ]]; then
                                python3 "$FLOPPY_DIR/$AUTORUN_FILE"
                            elif [[ "$AUTORUN_FILE" == *.mp3 ]]; then
                                mpg123 -q "$FLOPPY_DIR/$AUTORUN_FILE" 2>/dev/null
                            elif [[ "$AUTORUN_FILE" == *.sh ]]; then
                                bash "$FLOPPY_DIR/$AUTORUN_FILE"
                            fi
                            exit 0
                        fi
                    fi
                    
                    SCRIPT_FILE=$(ls -1 "$FLOPPY_DIR"/*.sh 2>/dev/null | head -n 1)
                    if [ -n "$SCRIPT_FILE" ]; then
                        echo -e "${WHITE}Executing $SCRIPT_FILE...${NC}"
                        bash "$SCRIPT_FILE"
                    else
                        echo -e "${RED}No auto-run media or scripts found on floppy.${NC}"
                    fi
                fi
                ;;
            5)
                echo -e "${ORANGE}========================================${NC}"
                echo -e "${WHITE} VIRTUAL FLOPPY EMULATOR${NC}"
                echo -e "${ORANGE}========================================${NC}"
                sudo mkdir -p "$FLOPPY_DIR" 2>/dev/null
                if mountpoint -q "$FLOPPY_DIR" 2>/dev/null; then
                    echo -e "${RED}A disk or image is already mounted at $FLOPPY_DIR.${NC}"
                    echo -e "${WHITE}Use 'del! -> 5' to unmount and destroy it first.${NC}"
                else
                    echo -e "${WHITE}Generating 1.44MB Virtual Disk...${NC}"
                    dd if=/dev/zero of="$VIRTUAL_IMG" bs=1024 count=1440 status=none
                    echo -e "${WHITE}Formatting as FAT12 (Standard Floppy)...${NC}"
                    if ! command -v mkfs.fat >/dev/null 2>&1; then
                        sudo apt-get install -y dosfstools >/dev/null 2>&1
                    fi
                    mkfs.fat -F 12 "$VIRTUAL_IMG" >/dev/null 2>&1
                    echo -e "${WHITE}Mounting to $FLOPPY_DIR...${NC}"
                    sudo mount -o loop "$VIRTUAL_IMG" "$FLOPPY_DIR"
                    echo -e "${GREEN}Virtual Emulator Online. System sees it as physical hardware.${NC}"
                    echo -e "${ORANGE}Don't forget to run 'word@ init' to stamp it!${NC}"
                fi
                press_enter
                ;;
        esac
        exit 0
        ;;

    "view")
        read -p "Enter target name to view/play: " target
        
        if [ -f "$BANK_DIR/text/$target.txt" ]; then
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} STREAMING DATA: $target.txt${NC}"
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE}"
            
            while IFS= read -r line; do
                for (( i=0; i<${#line}; i++ )); do
                    echo -n "${line:$i:1}"
                    sleep 0.02
                done
                echo ""
            done < "$BANK_DIR/text/$target.txt"
            
            echo -e "${NC}"
            echo -e "${ORANGE}========================================${NC}"
            
        elif [ -f "$BANK_DIR/audio/$target.mp3" ]; then
            if ! command -v mpg123 >/dev/null 2>&1; then
                echo -e "${RED}mpg123 is missing. Run 'word@ ?inst' to resolve.${NC}"
                exit 1
            fi
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} PLAYING AUDIO: $target.mp3${NC}"
            echo -e "${ORANGE}========================================${NC}"
            mpg123 -q "$BANK_DIR/audio/$target.mp3" 2>/dev/null
        else
            echo -e "${RED}Target '$target' not found in WordBank.${NC}"
        fi
        exit 0
        ;;

    "?flop")
        if mount | grep -q "$FLOPPY_DIR"; then
            df -h "$FLOPPY_DIR" | awk 'NR==1 || NR==2'
        else
            echo -e "${RED}No floppy mounted at $FLOPPY_DIR.${NC}"
        fi
        exit 0
        ;;

    "?gath")
        FILE_COUNT=$(find "$BANK_DIR" -type f | wc -l)
        if [ "$FILE_COUNT" -eq 0 ]; then
            echo -e "${ORANGE}The WordBank is currently empty.${NC}"
            exit 0
        fi
        BANK_SIZE=$(du -sh "$BANK_DIR" | awk '{print $1}')
        echo -e "${WHITE}Total Files  : $FILE_COUNT${NC}"
        echo -e "${WHITE}Total Weight : $BANK_SIZE${NC}"
        
        echo -e "\n${ORANGE}--- TEXT ---${NC}"
        ls -lh "$BANK_DIR"/text 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- AUDIO ---${NC}"
        ls -lh "$BANK_DIR"/audio 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- IMAGES ---${NC}"
        ls -lh "$BANK_DIR"/images 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- GAMES ---${NC}"
        ls -lh "$BANK_DIR"/games 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        exit 0
        ;;

    "?when")
        ls -lt --time-style=+"%Y-%m-%d %H:%M" "$BANK_DIR"/*/* 2>/dev/null | awk '{print $6 " " $7 "\t" $8}'
        exit 0
        ;;

    "del!")
        echo -e "${RED}========================================${NC}"
        echo -e "${WHITE} BURN PROTOCOL INITIATED${NC}"
        echo -e "${RED}========================================${NC}"
        echo -e " 1) File         (Erase specific document)"
        echo -e " 2) Bank         (Purge local WordBank)"
        echo -e " 3) Floppy       (Format mounted physical disk)"
        echo -e " 4) Reset        (Full system ledger & bank reset)"
        echo -e " 5) Virtual Floppy (Unmount & delete virtual .img)"
        echo -e "${RED}========================================${NC}"
        read -p "Select protocol (1-5): " burn_choice

        case "$burn_choice" in
            1)
                read -p "Enter exact filename to burn (e.g. story.txt): " target
                FOUND=$(find "$BANK_DIR" -type f -name "$target" | head -n 1)
                if [ -n "$FOUND" ]; then
                    rm -f "$FOUND"
                    echo -e "${RED}Erased.${NC}"
                else
                    echo -e "${ORANGE}Not found.${NC}"
                fi
                press_enter
                ;;
            2)
                rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/* "$BANK_DIR"/games/*
                echo -e "${RED}Entire WordBank purged.${NC}"
                ;;
            3)
                sudo rm -rf "$FLOPPY_DIR"/* && echo -e "${RED}Physical disk wiped.${NC}"
                ;;
            4)
                > "$LEDGER_FILE"
                rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/* "$BANK_DIR"/games/*
                echo -e "${RED}System Reset Complete.${NC}"
                ;;
            5)
                if [ -f "$VIRTUAL_IMG" ]; then
                    sudo umount "$FLOPPY_DIR" 2>/dev/null
                    rm -f "$VIRTUAL_IMG"
                    echo -e "${RED}Virtual Floppy image destroyed.${NC}"
                else
                    echo -e "${ORANGE}No virtual floppy image found.${NC}"
                fi
                press_enter
                ;;
        esac
        exit 0
        ;;

    "?work")
        [ -w "$BANK_DIR" ] && echo -e "Bank Directory   : ${WHITE}[OK]${NC}" || echo -e "Bank Directory   : ${RED}[FAIL]${NC}"
        ping -c 1 8.8.8.8 >/dev/null 2>&1 && echo -e "Network Access   : ${WHITE}[ONLINE]${NC}" || echo -e "Network Access   : ${RED}[OFFLINE]${NC}"
        exit 0
        ;;

    "update")
        if sudo curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word@" -o /usr/local/bin/word@; then
            sudo chmod +x /usr/local/bin/word@
            echo -e "${GREEN}word@ updated to latest version.${NC}"
        fi
        exit 0
        ;;

    *)
        echo -e "${RED}Unknown command. Type 'word@' to see the dashboard or 'word@ help!' for descriptions.${NC}"
        ;;
esac
