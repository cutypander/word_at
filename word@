#!/bin/bash

# ==========================================
# SYSTEM VARIABLES & PATHS
# ==========================================
BANK_DIR="$HOME/word_at_bank"
FLOPPY_DIR="/mnt/floppy"
LEDGER_FILE="$HOME/.floppy_ledger"
SAFE_OVERHEAD=50

# The Word@ Color Palette
ORANGE='\033[38;5;208m'
WHITE='\033[1;37m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Phonetic Array for Disk Naming
NATO=(ALPHA BRAVO CHARLIE DELTA ECHO FOXTROT GOLF HOTEL INDIA JULIETT KILO LIMA MIKE NOVEMBER OSCAR PAPA QUEBEC ROMEO SIERRA TANGO UNIFORM VICTOR WHISKEY XRAY YANKEE ZULU)

# Guarantee local Bank, Ledger, and Subfolders exist
mkdir -p "$BANK_DIR/text"
mkdir -p "$BANK_DIR/audio"
mkdir -p "$BANK_DIR/images"
touch "$LEDGER_FILE"


# ==========================================
# word@ ?calc - HYBRID PYTHON MATH ENGINE
# ==========================================
execute_python_math() {
    local math_input="$1"
    
    if [[ "${math_input,,}" == "pi" ]]; then
        echo -e "${ORANGE} STREAMING NILAKANTHA SERIES (Press CTRL+C to stop)${NC}"
        tput civis
        python3 -c "
import sys, time
pi_est = 3.0
n = 2
sign = 1
print('\033[1;37m Formula: Pi = 3 + 4/(2*3*4) - 4/(4*5*6) + 4/(6*7*8)...\033[0m\n')
try:
    iteration = 1
    while True:
        term = 4.0 / (n * (n+1) * (n+2))
        if sign == 1: pi_est += term
        else: pi_est -= term
        sys.stdout.write(f'\r \033[0;32m[Iter {iteration}]\033[0m Math: {\"+\" if sign==1 else \"-\"}{term:.8f} | Current Pi ≈ {pi_est:.14f}')
        sys.stdout.flush()
        n += 2
        sign *= -1
        iteration += 1
        time.sleep(0.05)
except KeyboardInterrupt:
    sys.stdout.write('\n\n\033[0;31m Calculation Halted.\033[0m\n')
    sys.exit(0)
"
        tput cnorm
        echo -e "\n"
    else
        python3 -c "
import sys, time
from math import *

expr = sys.argv[1]

# Erase spaces entirely to protect bracket parsing logic and auto-convert ^ to **
s = expr.replace('{','(').replace('}',')').replace('[','(').replace(']',')').replace('x','*').replace('X','*').replace('^','**')
s = s.replace(' ', '')

print(f'\033[1;37m[Original]\033[0m {s}')

try:
    step = 1
    while '(' in s:
        start = s.rfind('(')
        end = s.find(')', start)
        if end == -1: raise ValueError('Unmatched bracket')
        
        func_start = start
        while func_start > 0 and s[func_start-1].isalpha():
            func_start -= 1
            
        chunk = s[func_start:end+1]
        val = eval(chunk)
        if isinstance(val, float) and val.is_integer(): val = int(val)
        
        s = s[:func_start] + str(val) + s[end+1:]
        time.sleep(0.3)
        print(f'\033[38;5;208m[Step {step}]\033[0m  {s}')
        step += 1
        
    ans = eval(s)
    if isinstance(ans, float) and ans.is_integer(): ans = int(ans)
    time.sleep(0.3)
    print(f'\033[0;32m[Final]\033[0m    {ans}\n')
    
except Exception as e:
    print('\033[0;31m Invalid Syntax or Math Error\033[0m\n')
" "$math_input"
    fi
}

interactive_calculator() {
    clear
    echo -e "${ORANGE}========================================${NC}"
    echo -e "${WHITE} INTERACTIVE MATH ENGINE${NC}"
    echo -e "${ORANGE}========================================${NC}"
    echo -e " ${WHITE}[Operators]${NC} +, -, *, /, ** or ^ (Power), % (Modulo)"
    echo -e " ${WHITE}[Brackets]${NC}  (), [], {} (Auto-translates to parens)"
    echo -e " ${WHITE}[Functions]${NC} sqrt(x), factorial(x), abs(x), log(x)"
    echo -e " ${WHITE}[Trig]     ${NC} sin(x), cos(x), tan(x), degrees(x)"
    echo -e " ${WHITE}[Constants]${NC} pi, e, tau"
    echo -e "${ORANGE}----------------------------------------${NC}"
    echo -e " Type 'pi' to watch infinite series math live."
    echo -e " Type 'q' or 'exit' to return to menu."
    echo -e "${ORANGE}========================================${NC}"

    while true; do
        read -p " Math > " math_input
        
        if [[ "$math_input" == "q" || "$math_input" == "exit" || -z "$math_input" ]]; then
            echo -e "${WHITE}Returning to menu...${NC}"
            sleep 1; calculator_engine
            return
        fi
        
        execute_python_math "$math_input"
    done
}

file_calculator() {
    local tmp_math="$BANK_DIR/text/.calc_input.tmp"
    
    # Ensure file is empty and ready
    > "$tmp_math"
    
    # Open editor (like 'write' command)
    if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$tmp_math" 2>/dev/null || nano "$tmp_math"
        echo -e "${WHITE}Waiting for editor to close... Press [ENTER] when done saving.${NC}"
        read -r
    else
        nano "$tmp_math"
    fi

    clear
    echo -e "${ORANGE}========================================${NC}"
    echo -e "${WHITE} PROCESSING FILE DATA...${NC}"
    echo -e "${ORANGE}========================================${NC}"
    
    local has_content=0
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip empty lines
        [[ -z "$(echo -e "${line}" | tr -d '[:space:]')" ]] && continue
        has_content=1
        
        execute_python_math "$line"
        echo -e "${ORANGE}----------------------------------------${NC}"
    done < "$tmp_math"
    
    if [ "$has_content" -eq 0 ]; then
        echo -e "${RED}File was empty. No math processed.${NC}"
    fi
    
    # Burn the evidence
    rm -f "$tmp_math"
    echo -e "\n${WHITE}Temporary file burned. Press any key to return...${NC}"
    read -n 1 -s
    calculator_engine
}

calculator_engine() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo -e "${RED}Error: python3 is not installed. Run 'word@' to install dependencies.${NC}"
        exit 1
    fi

    clear
    echo -e "${ORANGE}========================================${NC}"
    echo -e "${WHITE} word@ MATH DASHBOARD${NC}"
    echo -e "${ORANGE}========================================${NC}"
    echo -e " [1] from_file  (Paste/Write complex math in a .txt)"
    echo -e " [2] calculator (Interactive terminal prompt)"
    echo -e " [q] Return to Terminal"
    echo -e "${ORANGE}========================================${NC}"
    read -n 1 -p " Select mode: " calc_mode
    echo ""

    case $calc_mode in
        1) file_calculator ;;
        2) interactive_calculator ;;
        q|Q) clear; exit 0 ;;
        *) echo "Invalid selection."; sleep 1; calculator_engine ;;
    esac
}


# ==========================================
# THE SWITCHBOARD
# ==========================================
case "$1" in

    "")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} word@ SYSTEM DASHBOARD${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "Available Commands:"
        echo -e "  write, raw, ?rec, TTF, STF, init"
        echo -e "  ?scan, ?flop, ?gath, ?when, view, del!"
        echo -e "  help!, ?work, ?calc, update"
        echo -e "${ORANGE}========================================${NC}"

        MISSING_PKGS=()
        
        # Check required system binaries and map to their apt packages
        command -v ffmpeg >/dev/null 2>&1 || MISSING_PKGS+=("ffmpeg")
        command -v mpg123 >/dev/null 2>&1 || MISSING_PKGS+=("mpg123")
        command -v arecord >/dev/null 2>&1 || MISSING_PKGS+=("alsa-utils")
        command -v wodim >/dev/null 2>&1 || MISSING_PKGS+=("wodim")
        command -v qsstv >/dev/null 2>&1 || MISSING_PKGS+=("qsstv")
        command -v convert >/dev/null 2>&1 || MISSING_PKGS+=("imagemagick")
        command -v python3 >/dev/null 2>&1 || MISSING_PKGS+=("python3")

        # The Visual Installer Protocol
        if [ ${#MISSING_PKGS[@]} -gt 0 ]; then
            echo -e "\n${WHITE}Want to install the necessary files? Y/N${NC}"
            read -p "> " install_choice
            if [[ "$install_choice" == "Y" || "$install_choice" == "y" ]]; then
                echo -e "\n${ORANGE}Updating grid repositories...${NC}"
                sudo apt-get update -qq
                echo ""
                
                for pkg in "${MISSING_PKGS[@]}"; do
                    echo -e "- installing $pkg"
                    if sudo apt-get install -y "$pkg" >/dev/null 2>&1; then
                        echo -e "${GREEN}- $pkg installed${NC}\n"
                    else
                        echo -e "${RED}- $pkg failed to install${NC}\n"
                    fi
                done
                
                echo -e "${ORANGE}- auto clearing in 3 seconds...${NC}"
                sleep 3
                clear
            fi
        fi
        exit 0
        ;;

    "?well")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE}   Welcome to the Terminal Workspace    ${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${ORANGE}This is a distraction-free media environment."
        echo -e "Everything you record is secured in a local bank"
        echo -e "before being archived to physical floppy disks.${NC}\n"
        
        if mount | grep -q "$FLOPPY_DIR"; then
            echo -e "  Hardware Status : ${WHITE}[FLOPPY DRIVE ACTIVE]${NC}"
        else
            echo -e "  Hardware Status : ${RED}[NO DISK MOUNTED]${NC}"
        fi
        echo ""
        
        echo -e "${ORANGE}To see the available commands, type: ${WHITE}word@ help!${NC}"
        echo -e "${ORANGE}========================================${NC}"
        exit 0
        ;;

    "help!")
        clear # Wipe the terminal for clean formatting
        
        if [ "$2" == "tree" ]; then
            echo -e "${WHITE}SYSTEM HIERARCHY:${NC}"
            echo -e "${ORANGE}word@${NC}"
            echo -e "├── help!"
            echo -e "│   ├── tree (Visual structure)"
            echo -e "│   └── desc (Detailed manual)"
            echo -e "├── write [filename]"
            echo -e "├── raw [filename]"
            echo -e "├── ?rec"
            echo -e "├── view [target]"
            echo -e "│   ├── .txt (Text Stream)"
            echo -e "│   └── .mp3 (Audio Playback)"
            echo -e "├── STF (Sound to Floppy)"
            echo -e "│   ├── 1) Short Profile"
            echo -e "│   ├── 2) Standard Profile"
            echo -e "│   ├── 3) Long Profile"
            echo -e "│   └── 4) Auto Profile"
            echo -e "├── TTF (Text to Floppy)"
            echo -e "├── init"
            echo -e "├── ?calc"
            echo -e "│   ├── 1) from_file"
            echo -e "│   └── 2) interactive"
            echo -e "├── ?scan"
            echo -e "│   ├── 1) Surface Scan"
            echo -e "│   ├── 2) Local Hunt"
            echo -e "│   ├── 3) Ledger Scan"
            echo -e "│   ├── 4) Auto-Execute"
            echo -e "│   └── 5) System Dependencies"
            echo -e "├── del!"
            echo -e "│   ├── 1) File"
            echo -e "│   ├── 2) Bank"
            echo -e "│   ├── 3) Floppy"
            echo -e "│   └── 4) Reset"
            echo -e "├── ?flop"
            echo -e "├── ?gath"
            echo -e "├── ?when"
            echo -e "├── ?work"
            echo -e "└── update"
            
        elif [ "$2" == "desc" ]; then
            echo -e "${WHITE}DETAILED COMMAND DESCRIPTIONS:${NC}"
            echo -e "${ORANGE}write [filename]${NC} - Opens or creates a text file. Automatically routes to a GUI editor if on a desktop, or defaults to Nano in a pure terminal."
            echo -e "${ORANGE}raw [filename]${NC}   - A distraction-free, direct terminal writing mode. Type //SAVE on a new line to keep your draft, or //REJECT to instantly burn it."
            echo -e "${ORANGE}?rec${NC}             - Audio field recorder. Uses 'arecord' to capture live audio and 'ffmpeg' to compress it into the WordBank's audio subfolder."
            echo -e "${ORANGE}STF${NC}              - Sound To Floppy. Compresses and transfers audio to disk. Offers 4 profiles: 1) Short (High Q), 2) Standard, 3) Long (Max Length), 4) Auto (Fits exact remaining space)."
            echo -e "${ORANGE}TTF${NC}              - Text To Floppy. Scans the local WordBank text directory and safely archives files to the inserted floppy disk without exceeding capacity."
            echo -e "${ORANGE}view [target]${NC}    - Universal media viewer. Streams text files using a 16-bit typewriter effect or plays mp3 files using the 'mpg123' audio engine."
            echo -e "${ORANGE}?calc${NC}            - Floating-point math calculator powered by a background Python engine. Includes interactive and from_file modes."
            echo -e "${ORANGE}?scan${NC}            - Multi-tool diagnostic suite. 1) Magnetic surface scan. 2) Local system file hunt. 3) Physical disk ledger search. 4) Floppy auto-run trigger. 5) Dependency check."
            echo -e "${ORANGE}del!${NC}             - System burn protocols. Safely erase a specific file (1), purge your entire local WordBank (2), wipe the physical floppy (3), or execute a total factory reset (4)."
            echo -e "${ORANGE}init${NC}             - Initializes a new floppy disk. Generates a random NATO phonetic name, stamps a unique ID, runs a magnetic badblock scan, and updates the local ledger."
            echo -e "${ORANGE}?flop / ?gath${NC}    - Hardware metrics. '?flop' checks the mounted floppy drive status. '?gath' calculates total WordBank size and individual file weights across all subfolders."
            echo -e "${ORANGE}?when / ?work${NC}    - System info. '?when' displays creation and modification dates for all files. '?work' runs diagnostic checks on directory write-access and network connectivity."
            echo -e "${ORANGE}update${NC}           - Connects to GitHub, pulls the latest word@ script from the main branch, and overwrites the local binary."
            echo -e "${ORANGE}help! [tree/desc]${NC}- Displays this documentation. 'tree' maps the interactive branch structure. 'desc' shows verbose explanations. No flag shows the quick reference."
            
        else
            echo -e "${WHITE}QUICK REFERENCE:${NC}"
            echo -e "  ${WHITE}write${NC}     - Open/create text (Nano/Desktop)"
            echo -e "  ${WHITE}raw${NC}       - Write directly in terminal"
            echo -e "  ${WHITE}?rec${NC}      - Record MP3 audio"
            echo -e "  ${WHITE}STF${NC}       - Audio to floppy (Profiles: 1-Short, 2-Std, 3-Long, 4-Auto)"
            echo -e "  ${WHITE}TTF${NC}       - Text to floppy"
            echo -e "  ${WHITE}view${NC}      - Play MP3 or stream text"
            echo -e "  ${WHITE}?calc${NC}     - Python-powered Math Engine"
            echo -e "  ${WHITE}?scan${NC}     - Tools (1-Surface, 2-Hunt, 3-Ledger, 4-Autorun, 5-Dep Check)"
            echo -e "  ${WHITE}del!${NC}      - Erase (1-File, 2-Bank, 3-Floppy, 4-Reset)"
            echo -e "  ${WHITE}init${NC}      - Format and stamp floppy"
            echo -e "  ${WHITE}?flop${NC}     - Floppy drive hardware status"
            echo -e "  ${WHITE}?gath${NC}     - WordBank file sizes/weights by folder"
            echo -e "  ${WHITE}?when${NC}     - Global file timestamps"
            echo -e "  ${WHITE}?work${NC}     - Directory & network health check"
            echo -e "  ${WHITE}update${NC}    - Pull latest version from GitHub"
            echo -e "  ${WHITE}help!${NC}     - Options: 'tree' (structure) or 'desc' (detailed manual)"
        fi
        exit 0
        ;;

    "write")
        if [ -n "$2" ]; then
            filename="$2"
        else
            read -p "Enter document name: " filename
        fi
        filepath="$BANK_DIR/text/$filename.txt"
        
        # Guarantee the file actually exists before opening
        touch "$filepath"
        
        if [ -n "$DISPLAY" ] && command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$filepath" 2>/dev/null || nano "$filepath"
        else
            nano "$filepath"
        fi
        exit 0
        ;;

    "raw")
        if [ -n "$2" ]; then
            filename="$2"
        else
            read -p "Enter document name: " filename
        fi
        
        TEMP_FILE="$BANK_DIR/text/.$filename.tmp"
        FINAL_FILE="$BANK_DIR/text/$filename.txt"
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} RAW WRITING MODE ENGAGED${NC}"
        echo -e "${ORANGE} Type //SAVE on a new line to keep your work."
        echo -e " Type //REJECT on a new line to burn it.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        > "$TEMP_FILE"
        
        while IFS= read -r line; do
            if [[ "$line" == "//SAVE" ]]; then
                mv "$TEMP_FILE" "$FINAL_FILE"
                echo -e "${WHITE}Draft secured in Bank as $filename.txt${NC}"
                exit 0
            elif [[ "$line" == "//REJECT" ]]; then
                rm -f "$TEMP_FILE"
                echo -e "${RED}Draft rejected. Burned to ash.${NC}"
                exit 0
            else
                echo "$line" >> "$TEMP_FILE"
            fi
        done
        ;;

    "?rec")
        if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v arecord >/dev/null 2>&1; then
            echo -e "${RED}Cannot continue, relevant files missing, re-execute word@ command.${NC}"
            exit 1
        fi
        
        read -p "Enter a name for this recording: " rec_name
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} LIVE AUDIO RECORDING${NC}"
        echo -e "${ORANGE} Press [ENTER] to stop recording.${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        TEMP_WAV="$BANK_DIR/audio/.$rec_name.tmp.wav"
        FINAL_MP3="$BANK_DIR/audio/$rec_name.mp3"
        
        arecord -f cd "$TEMP_WAV" -q &
        RECORD_PID=$!
        
        read -r
        kill $RECORD_PID 2>/dev/null
        
        echo -e "${WHITE}Processing audio...${NC}"
        if ffmpeg -y -i "$TEMP_WAV" -qscale:a 2 "$FINAL_MP3" 2>/dev/null; then
            rm -f "$TEMP_WAV"
            echo -e "${GREEN}Recording saved to WordBank as $rec_name.mp3${NC}"
        else
            echo -e "${RED}Error: Audio processing failed.${NC}"
        fi
        exit 0
        ;;

    "init")
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: No disk inserted to initialize.${NC}"
            exit 1
        fi
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE}   INITIALIZING NEW FLOPPY HARDWARE${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        NEW_ID=$(tr -dc A-Z0-9 </dev/urandom | head -c 6)
        WORD1=${NATO[$RANDOM % 26]}
        if grep -q "NAME: $WORD1" "$LEDGER_FILE"; then
            WORD2=${NATO[$RANDOM % 26]}
            DISK_NAME="$WORD1-$WORD2"
        else
            DISK_NAME="$WORD1"
        fi
        
        echo "$NEW_ID" > "$FLOPPY_DIR/.disk_id"
        echo -e "${WHITE}Hardware Stamped. Assigned Name: $DISK_NAME${NC}"
        
        echo -e "${ORANGE}Running deep magnetic scan (This will take a moment)...${NC}"
        DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
        BAD_COUNT=$(sudo badblocks -q "$DEVICE" | wc -l)
        
        if [ "$BAD_COUNT" -gt 0 ]; then
            echo -e "${RED}WARNING: $BAD_COUNT dead sectors detected.${NC}"
        else
            echo -e "${GREEN}Scan complete. Surface integrity is 100%.${NC}"
        fi
        
        echo "ID: $NEW_ID | NAME: $DISK_NAME | BAD_BLOCKS: $BAD_COUNT" >> "$LEDGER_FILE"
        echo -e "${GREEN}Disk successfully integrated into the ecosystem.${NC}"
        exit 0
        ;;

    "TTF")
        echo -e "${WHITE}Initiating Text-to-Floppy Archive Protocol...${NC}"
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: Floppy drive not detected.${NC}"
            exit 1
        fi

        CURRENT_ID=$(cat "$FLOPPY_DIR/.disk_id" 2>/dev/null)
        if [ -z "$CURRENT_ID" ]; then
            echo -e "${RED}Disk is uninitialized. Run 'word@ init' first.${NC}"
            exit 1
        fi

        KNOWN_NAME=$(grep "ID: $CURRENT_ID" "$LEDGER_FILE" | awk -F'NAME: ' '{print $2}' | awk '{print $1}')
        BAD_BLOCKS=$(grep "ID: $CURRENT_ID" "$LEDGER_FILE" | awk -F'BAD_BLOCKS: ' '{print $2}' | awk '{print $1}')
        
        echo -e "${ORANGE}Archiving Bank to Floppy: $KNOWN_NAME${NC}"

        FREE_SPACE=$(df -k "$FLOPPY_DIR" | awk 'NR==2 {print $4}')
        SAFE_SPACE=$((FREE_SPACE - BAD_BLOCKS - SAFE_OVERHEAD))

        for FILE in "$BANK_DIR"/text/*.txt; do
            [ -e "$FILE" ] || continue
            FILE_SIZE=$(du -k "$FILE" | cut -f1)
            REQUIRED_SPACE=$((FILE_SIZE * 2))

            if [ "$REQUIRED_SPACE" -le "$SAFE_SPACE" ]; then
                BASENAME=$(basename "$FILE")
                NAME="${BASENAME%.*}"
                
                cp "$FILE" "$FLOPPY_DIR/${NAME}.txt"
                cp "$FILE" "$FLOPPY_DIR/${NAME}_BKP.txt"
                
                if ! grep -q "DISK_ID: $CURRENT_ID | FILE: $BASENAME" "$LEDGER_FILE"; then
                    echo "DISK_ID: $CURRENT_ID | DISK_NAME: $KNOWN_NAME | FILE: $BASENAME | DATE: $(date +%F)" >> "$LEDGER_FILE"
                fi
                
                SAFE_SPACE=$((SAFE_SPACE - REQUIRED_SPACE))
                echo -e "${WHITE}Archived & Indexed: $BASENAME${NC}"
            else
                echo -e "${RED}Skipped: $BASENAME (Exceeds remaining space)${NC}"
            fi
        done
        echo -e "${GREEN}TTF Transfer Complete.${NC}"
        exit 0
        ;;

    "STF")
        if ! command -v ffmpeg >/dev/null 2>&1; then
            echo -e "${RED}Cannot continue, relevant files missing, re-execute word@ command.${NC}"
            exit 1
        fi
        
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} SOUND TO FLOPPY ARCHIVE PROTOCOL${NC}"
        echo -e "${ORANGE}========================================${NC}"
        
        if [ ! -d "$FLOPPY_DIR" ]; then
            echo -e "${RED}Error: Floppy drive not detected.${NC}"
            exit 1
        fi
        
        shopt -s nullglob
        files=("$BANK_DIR"/audio/*.mp3)
        shopt -u nullglob
        
        if [ ${#files[@]} -eq 0 ]; then
            echo -e "${RED}No audio files found in WordBank.${NC}"
            exit 1
        fi

        i=1
        for f in "${files[@]}"; do
            basename=$(basename "$f" | tr '[:lower:]' '[:upper:]')
            echo -e "  ${WHITE}$i)${NC} $basename"
            ((i++))
        done
        
        read -p "Select file number: " choice
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#files[@]}" ]; then
            echo -e "${RED}Invalid selection.${NC}"
            exit 1
        fi
        
        SELECTED_FILE="${files[$((choice-1))]}"
        BASENAME=$(basename "$SELECTED_FILE")
        
        echo -e "\n${ORANGE}Select Compression Profile:${NC}"
        echo -e "  1) Short    (32kbps - High Quality)"
        echo -e "  2) Standard (16kbps - Balanced)"
        echo -e "  3) Long     (8kbps  - Max Length)"
        echo -e "  4) Auto     (Fit perfectly to disk)"
        read -p "Choice (1-4): " q_choice

        FREE_SPACE_KB=$(df -k "$FLOPPY_DIR" | awk 'NR==2 {print $4}')
        if [ "$FREE_SPACE_KB" -le 0 ]; then
            echo -e "${RED}Error: Floppy is completely full.${NC}"
            exit 1
        fi

        TARGET_BITRATE="16k" 
        case "$q_choice" in
            1) TARGET_BITRATE="32k" ;;
            2) TARGET_BITRATE="16k" ;;
            3) TARGET_BITRATE="8k" ;;
            4) 
                DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$SELECTED_FILE" | awk '{print int($1)}')
                if [ "$DURATION" -le 0 ]; then DURATION=1; fi
                MAX_BITRATE=$(( (FREE_SPACE_KB * 8) / DURATION ))
                SAFE_BITRATE=$(( MAX_BITRATE * 95 / 100 ))
                
                if [ "$SAFE_BITRATE" -lt 6 ]; then
                    echo -e "${RED}WARNING: File is too long. Audio will be heavily degraded.${NC}"
                    TARGET_BITRATE="6k"
                elif [ "$SAFE_BITRATE" -gt 64 ]; then
                    TARGET_BITRATE="64k" 
                else
                    TARGET_BITRATE="${SAFE_BITRATE}k"
                fi
                echo -e "${ORANGE}Auto-calculated Bitrate: $TARGET_BITRATE${NC}"
                ;;
            *) echo -e "${RED}Invalid profile. Defaulting to 16kbps.${NC}" ;;
        esac

        echo -e "${WHITE}Compressing & Transferring...${NC}"
        if ffmpeg -y -i "$SELECTED_FILE" -c:a libmp3lame -b:a "$TARGET_BITRATE" -ac 1 -ar 16000 "$FLOPPY_DIR/$BASENAME" 2>/dev/null; then
            echo -e "${GREEN}Audio secured on physical disk.${NC}"
            
            read -p "Set this track to Auto-Run on insert? (Y/N): " autorun_choice
            if [[ "$autorun_choice" == "Y" || "$autorun_choice" == "y" ]]; then
                echo "$BASENAME" > "$FLOPPY_DIR/.autorun"
                echo -e "${WHITE}Auto-Run protocol established.${NC}"
            fi
        else
            echo -e "${RED}Error: Audio compression failed.${NC}"
        fi
        exit 0
        ;;

    "?calc")
        calculator_engine
        ;;

    "?scan")
        echo -e "${ORANGE}========================================${NC}"
        echo -e "${WHITE} ADVANCED SCANNER PROTOCOLS${NC}"
        echo -e "${ORANGE}========================================${NC}"
        echo -e "  ${WHITE}1)${NC} Surface Scan (Check magnetic integrity)"
        echo -e "  ${WHITE}2)${NC} Local Hunt   (Search Pi and move to Bank)"
        echo -e "  ${WHITE}3)${NC} Ledger Scan  (Find a file's physical disk)"
        echo -e "  ${WHITE}4)${NC} Auto-Execute (Trigger .autorun or script)"
        echo -e "  ${WHITE}5)${NC} Check System Dependencies"
        echo -e "${ORANGE}========================================${NC}"
        read -p "Select protocol (1-5): " scan_choice

        case "$scan_choice" in
            1)
                DEVICE=$(df "$FLOPPY_DIR" | tail -1 | awk '{print $1}')
                echo -e "${ORANGE}Listening for dead sectors on $DEVICE...${NC}"
                sudo badblocks -v "$DEVICE"
                ;;
            2)
                read -p "Enter exact filename to hunt: " hunt_target
                echo -e "${ORANGE}Sweeping local system...${NC}"
                FOUND_PATH=$(find "$HOME" -type f -name "$hunt_target" 2>/dev/null | head -n 1)
                
                if [ -n "$FOUND_PATH" ]; then
                    echo -e "${WHITE}Target acquired at: $FOUND_PATH${NC}"
                    read -p "Import to WordBank? (Y/N): " import_choice
                    if [[ "$import_choice" == "Y" || "$import_choice" == "y" ]]; then
                        cp "$FOUND_PATH" "$BANK_DIR/"
                    fi
                else
                    echo -e "${RED}File not found on local system.${NC}"
                fi
                ;;
            3)
                read -p "Enter document name to locate: " doc_target
                if grep -q "FILE: $doc_target" "$LEDGER_FILE"; then
                    grep "FILE: $doc_target" "$LEDGER_FILE"
                else
                    echo -e "${RED}Document not found in physical archives.${NC}"
                fi
                ;;
            4)
                if [ -d "$FLOPPY_DIR" ]; then
                    if [ -f "$FLOPPY_DIR/.autorun" ]; then
                        if ! command -v mpg123 >/dev/null 2>&1; then
                            echo -e "${RED}Cannot continue, relevant files missing, re-execute word@ command.${NC}"
                            exit 1
                        fi
                        AUTORUN_FILE=$(cat "$FLOPPY_DIR/.autorun")
                        if [ -f "$FLOPPY_DIR/$AUTORUN_FILE" ]; then
                            echo -e "${WHITE}Auto-Run triggered: $AUTORUN_FILE${NC}"
                            mpg123 -q "$FLOPPY_DIR/$AUTORUN_FILE" 2>/dev/null
                            exit 0
                        fi
                    fi
                    
                    SCRIPT_FILE=$(ls -1 "$FLOPPY_DIR"/*.sh 2>/dev/null | head -n 1)
                    if [ -n "$SCRIPT_FILE" ]; then
                        echo -e "${WHITE}Executing $SCRIPT_FILE...${NC}"
                        bash "$SCRIPT_FILE"
                    else
                        echo -e "${RED}No auto-run media or scripts found on floppy.${NC}"
                    fi
                fi
                ;;
            5)
                echo -e "${WHITE}Checking required packages...${NC}"
                for pkg in ffmpeg mpg123 arecord wodim qsstv convert python3; do
                    if command -v "$pkg" >/dev/null 2>&1; then
                        echo -e "${GREEN}[OK]${NC} $pkg is installed."
                    else
                        echo -e "${RED}[MISSING]${NC} $pkg"
                    fi
                done
                echo -e "${ORANGE}Type 'word@' without arguments to launch the auto-installer.${NC}"
                ;;
        esac
        exit 0
        ;;

    "view")
        read -p "Enter target name to view/play: " target
        
        if [ -f "$BANK_DIR/text/$target.txt" ]; then
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} STREAMING DATA: $target.txt${NC}"
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE}"
            
            while IFS= read -r line; do
                for (( i=0; i<${#line}; i++ )); do
                    echo -n "${line:$i:1}"
                    sleep 0.02
                done
                echo ""
            done < "$BANK_DIR/text/$target.txt"
            
            echo -e "${NC}"
            echo -e "${ORANGE}========================================${NC}"
            
        elif [ -f "$BANK_DIR/audio/$target.mp3" ]; then
            if ! command -v mpg123 >/dev/null 2>&1; then
                echo -e "${RED}Cannot continue, relevant files missing, re-execute word@ command.${NC}"
                exit 1
            fi
            echo -e "${ORANGE}========================================${NC}"
            echo -e "${WHITE} PLAYING AUDIO: $target.mp3${NC}"
            echo -e "${ORANGE}========================================${NC}"
            mpg123 -q "$BANK_DIR/audio/$target.mp3" 2>/dev/null
        else
            echo -e "${RED}Target '$target' not found in WordBank.${NC}"
        fi
        exit 0
        ;;

    "?flop")
        if mount | grep -q "$FLOPPY_DIR"; then
            df -h "$FLOPPY_DIR" | awk 'NR==1 || NR==2'
        else
            echo -e "${RED}No floppy mounted at $FLOPPY_DIR.${NC}"
        fi
        exit 0
        ;;

    "?gath")
        FILE_COUNT=$(find "$BANK_DIR" -type f | wc -l)
        if [ "$FILE_COUNT" -eq 0 ]; then
            echo -e "${ORANGE}The WordBank is currently empty.${NC}"
            exit 0
        fi
        BANK_SIZE=$(du -sh "$BANK_DIR" | awk '{print $1}')
        echo -e "${WHITE}Total Files  : $FILE_COUNT${NC}"
        echo -e "${WHITE}Total Weight : $BANK_SIZE${NC}"
        
        echo -e "\n${ORANGE}--- TEXT ---${NC}"
        ls -lh "$BANK_DIR"/text 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- AUDIO ---${NC}"
        ls -lh "$BANK_DIR"/audio 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        echo -e "${ORANGE}--- IMAGES ---${NC}"
        ls -lh "$BANK_DIR"/images 2>/dev/null | awk 'NR>1 {print $5 "\t" $9}'
        exit 0
        ;;

    "?when")
        ls -lt --time-style=+"%Y-%m-%d %H:%M" "$BANK_DIR"/*/* 2>/dev/null | awk '{print $6 " " $7 "\t" $8}'
        exit 0
        ;;

    "del!")
        echo -e "${RED}========================================${NC}"
        echo -e "${WHITE} BURN PROTOCOL INITIATED${NC}"
        echo -e "${RED}========================================${NC}"
        read -p "Select protocol (1=File, 2=Bank, 3=Floppy, 4=Reset): " burn_choice

        case "$burn_choice" in
            1)
                read -p "Enter exact filename to burn (e.g. story.txt): " target
                FOUND=$(find "$BANK_DIR" -name "$target")
                if [ -n "$FOUND" ]; then
                    rm -f "$FOUND"
                    echo -e "${RED}Erased.${NC}"
                else
                    echo -e "${ORANGE}Not found.${NC}"
                fi
                ;;
            2)
                rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/*
                echo -e "${RED}Entire WordBank purged.${NC}"
                ;;
            3)
                sudo rm -rf "$FLOPPY_DIR"/* && echo -e "${RED}Physical disk wiped.${NC}"
                ;;
            4)
                > "$LEDGER_FILE"
                rm -rf "$BANK_DIR"/text/* "$BANK_DIR"/audio/* "$BANK_DIR"/images/*
                echo -e "${RED}System Reset Complete.${NC}"
                ;;
        esac
        exit 0
        ;;

    "?work")
        [ -w "$BANK_DIR" ] && echo -e "Bank Directory   : ${WHITE}[OK]${NC}" || echo -e "Bank Directory   : ${RED}[FAIL]${NC}"
        ping -c 1 8.8.8.8 >/dev/null 2>&1 && echo -e "Network Access   : ${WHITE}[ONLINE]${NC}" || echo -e "Network Access   : ${RED}[OFFLINE]${NC}"
        exit 0
        ;;

    "update")
        if sudo curl -sL "https://raw.githubusercontent.com/cutypander/word_at/main/word@" -o /usr/local/bin/word@; then
            sudo chmod +x /usr/local/bin/word@
            echo -e "${GREEN}word@ updated to latest version.${NC}"
        fi
        exit 0
        ;;

    *)
        echo -e "${RED}Unknown command. Type 'word@' to see the dashboard or 'word@ help!' for descriptions.${NC}"
        ;;
esac
